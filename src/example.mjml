  <!-- START: CTA Buttons 2x1 (fixed width) -->
  <!--
    SHARED BUTTON WIDTH FORMULA (round DOWN so they never wrap):
      width = ( sectionWidth - leftPadding - rightPadding - (buttonCount - 1) * gap ) / buttonCount

      sectionWidth : 600   (= email width here; use the section's own width if narrower)
      padding      : 32 + 32
      gap          : 32     (between buttons)
      buttonCount  : 2
      => (600 - 32 - 32 - (2 - 1) * 32) / 2 = 504 / 2 = 252px

    If any value changes, update width:252px on every <a data-style-color data-style-href> AND width="252"/width:252px on every MSO <td>.
  -->
  <mj-section css-class="block" background-color="#ffffff" padding="0 32px" data-style-padding-top data-style-padding-right data-style-padding-bottom data-style-padding-left data-style-background-color data-style-border data-style-direction>

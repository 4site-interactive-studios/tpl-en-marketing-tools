              <mj-raw><tr><td height="128" style="height:128px;line-height:128px;font-size:0;">&nbsp;</td></tr></mj-raw>
            </mj-column>
          </mj-group>
      </mj-section>
    </mj-wrapper>

    <!-- == R4 OLD == -->
    <mj-section padding="16px 32px 8px"><mj-column><mj-text padding="0"><p style="font-size:14px;line-height:18px;color:#362229;margin:0;"><b>R4 OLD</b>: pre-change shape, 144px padding + button. Reference height.</p></mj-text></mj-column></mj-section>
    <mj-wrapper background-color="#4A7A68" padding="0">
      <mj-section css-class="image-block block video-band" background-url="assets/photo-kayak_color-overlay.jpg" background-size="cover" background-repeat="no-repeat" background-position="center center" padding="144px 0 144px">
        <mj-group>
          <mj-column width="25px">&nbsp;</mj-column>
          <mj-column width="550px">
            <mj-button width="auto" href="https://tpl.org" align="center" background-color="#4A7A68" color="#ffffff" border="2px solid #ffffff" padding="0">WATCH&nbsp;&nbsp;▷</mj-button>
          </mj-column>
          <mj-column width="25px">&nbsp;</mj-column>
        </mj-group>
      </mj-section>
    </mj-wrapper>

    <!-- == R5 OLD NONE == -->
    <mj-section padding="16px 32px 8px"><mj-column><mj-text padding="0"><p style="font-size:14px;line-height:18px;color:#362229;margin:0;"><b>R5 OLD NONE</b>: R4 without the button. Chromium: 288px (the drift).</p></mj-text></mj-column></mj-section>
    <mj-wrapper background-color="#4A7A68" padding="0">
      <mj-section css-class="image-block block video-band" background-url="assets/photo-kayak_color-overlay.jpg" background-size="cover" background-repeat="no-repeat" background-position="center center" padding="144px 0 144px">

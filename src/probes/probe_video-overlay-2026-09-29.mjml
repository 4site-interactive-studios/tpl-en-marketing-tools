    <mj-section padding="0 32px"><mj-column>
      <mj-raw><tr><td height="128" bgcolor="#F7931E" style="background-color:#F7931E;height:128px;line-height:128px;font-size:0;">&nbsp;</td></tr></mj-raw>
    </mj-column></mj-section>

    <mj-section padding="16px 32px 8px"><mj-column><mj-text padding="0"><p style="font-size:14px;line-height:18px;color:#362229;margin:0;"><b>M1 WATCH</b>: Grass band 338, Sky rails 128.</p></mj-text></mj-column></mj-section>
    <mj-section background-color="#8CC63F" padding="105px 0 105px">
        <mj-group>
          <mj-column width="25px" vertical-align="middle">
            <mj-raw><tr><td height="128" bgcolor="#5DD8D8" style="background-color:#5DD8D8;height:128px;line-height:128px;font-size:0;">&nbsp;</td></tr></mj-raw>
          </mj-column>
          <mj-column width="550px" vertical-align="middle">
            <mj-button width="auto" href="https://tpl.org" align="center" background-color="#4A7A68" color="#ffffff" border="2px solid #ffffff" padding="0">WATCH&nbsp;&nbsp;▷</mj-button>
          </mj-column>
          <mj-column width="25px" vertical-align="middle">
            <mj-raw><tr><td height="128" bgcolor="#5DD8D8" style="background-color:#5DD8D8;height:128px;line-height:128px;font-size:0;">&nbsp;</td></tr></mj-raw>
          </mj-column>

    <mj-section padding="16px 32px 8px"><mj-column><mj-text padding="0"><p style="font-size:14px;line-height:18px;color:#362229;margin:0;"><b>M2 PLAY ICON</b>: Grass band 338, Sky rails 128.</p></mj-text></mj-column></mj-section>
    <mj-section background-color="#8CC63F" padding="105px 0 105px">
        <mj-group>
          <mj-column width="25px" vertical-align="middle">
            <mj-raw><tr><td height="128" bgcolor="#5DD8D8" style="background-color:#5DD8D8;height:128px;line-height:128px;font-size:0;">&nbsp;</td></tr></mj-raw>
          </mj-column>
          <mj-column width="550px" vertical-align="middle">
            <mj-image src="assets/icon-play-circle_orange.png" width="128px" alt="Play video" href="https://tpl.org" align="center" padding="0" />
          </mj-column>
          <mj-column width="25px" vertical-align="middle">
            <mj-raw><tr><td height="128" bgcolor="#5DD8D8" style="background-color:#5DD8D8;height:128px;line-height:128px;font-size:0;">&nbsp;</td></tr></mj-raw>
          </mj-column>
        </mj-group>
    </mj-section>

    <mj-section padding="16px 32px 8px"><mj-column><mj-text padding="0"><p style="font-size:14px;line-height:18px;color:#362229;margin:0;"><b>M3 NONE</b>: Grass band 338, Sky rails 128.</p></mj-text></mj-column></mj-section>
    <mj-section background-color="#8CC63F" padding="105px 0 105px">
        <mj-group>
          <mj-column width="25px" vertical-align="middle">
            <mj-raw><tr><td height="128" bgcolor="#5DD8D8" style="background-color:#5DD8D8;height:128px;line-height:128px;font-size:0;">&nbsp;</td></tr></mj-raw>
          </mj-column>
          <mj-column width="550px" vertical-align="middle">
            <mj-raw><!-- Row 1 Button - Not Displayed --></mj-raw>
          </mj-column>
          <mj-column width="25px" vertical-align="middle">
            <mj-raw><tr><td height="128" bgcolor="#5DD8D8" style="background-color:#5DD8D8;height:128px;line-height:128px;font-size:0;">&nbsp;</td></tr></mj-raw>
          </mj-column>
        </mj-group>
    </mj-section>

    <mj-section padding="16px 0 0"><mj-column><mj-spacer height="16px" /></mj-column></mj-section>
    <mj-raw></div></div></mj-raw>
  </mj-body>
</mjml>

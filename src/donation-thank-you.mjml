<mjml lang="en">
  <mj-head>
    <!-- en-tools-config {
      "spacingScale": { "None": 0, "Half": 8, "Single": 16, "Double": 32, "Triple": 48, "Quadruple": 64 },
      "classSpacingScales": { "caption": { "None": 0, "Quarter": 4, "Half": 8, "Single": 16, "Double": 32, "Triple": 48, "Quadruple": 64 } },
      "widthPresets": { "Full Bleed": 0, "Single": 16, "Double": 32, "Triple": 48, "Quadruple": 64 },
      "geometryReachPx": 64,
      "brandColors": { "Snow": "#F5FAF1", "Moss": "#CEE4C5", "Earth": "#362229", "Evergreen": "#006837", "Fern": "#39B54A", "Grass": "#8CC63F", "Sky": "#5DD8D8", "Sun": "#F7931E", "Light Grey": "#FAFAFA" }
    } -->
    <mj-breakpoint width="600px" />
    <mj-title>TPL Donation Thank You — Auto-Responder</mj-title>
    <mj-preview>Please save a copy of this email — it serves as your tax receipt. Thank you for your generous gift to Trust for Public Land.</mj-preview>

    <!-- Baseline everything inherits -->
    <mj-attributes>
      <mj-text
        color="#000000"
        font-size="18px"
        font-weight="400"
        font-family="Tahoma, sans-serif"
        line-height="24px"
        css-class="wysiwyg"
      />
      <mj-button width="auto"
        css-class="button"
        font-size="18px"
        font-weight="700"
        font-family="Tahoma, sans-serif"
        line-height="25px"
        border-radius="100px"
        inner-padding="12px 16px"
        letter-spacing="1px"
        color="#ffffff"
        background-color="#006837"
      />
      <mj-image
        padding="0" />

      <!-- Reusable variants — apply with mj-class="*" -->
      <mj-class
        name="caption"
        font-size="10px"
        line-height="16px"
        padding="4px 0 0 0"
      />
    </mj-attributes>

    <mj-style>
      @media (max-width: 599px) {
        /* Indents the caption */
        .caption {
          padding-left: 16px !important;
          padding-right: 16px !important;
        }

        /* Side by Side CTA Buttons */
        .cta-item { display: block !important; margin: 0 0 16px 0 !important; }
        .cta-item:last-child { margin-bottom: 0 !important; }
      }
    </mj-style>

    <mj-raw>
      <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" />
      <meta name="format-detection" content="telephone=no" />
    </mj-raw>
    <mj-include path="./styles.css" type="css" />
  </mj-head>
  <mj-body background-color="#ffffff" css-class="email-body">
    <mj-include path="./partials/debug-toolbar.mjml" />
    <!-- START: Main Content -->

    <!-- START: Logo Hero (no CTA) -->
    <mj-section css-class="image-block block" background-color="#CEE4C5" padding="16px 32px">
      <mj-column vertical-align="middle">
        <mj-image css-class="light-only" src="assets/logo-tpl_color-black-text.png" alt="Trust for Public Land" href="https://www.tpl.org" width="154px" align="left" />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image css-class="dark-only" src="assets/logo-tpl_color-light-green-text.png" alt="Trust for Public Land" href="https://www.tpl.org" width="154px" align="left" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
      </mj-column>
    </mj-section>
    <!-- END: Logo Hero (no CTA) -->

    <!-- START: Heading -->
    <mj-section css-class="text-block block" background-color="#CEE4C5" padding="16px 32px">
      <mj-column><mj-text align="center" padding="0"><h1 style="color:#362229;">Thank you for your support!</h1></mj-text></mj-column>
    </mj-section>
    <!-- END: Heading -->

    <!-- START: Image (full-bleed) -->
    <mj-section css-class="image-block block" background-color="#ffffff" padding="0">
      <mj-column vertical-align="middle">
        <mj-image src="assets/photo-family.jpg" alt="Family celebrating on a mountain overlook" href="https://www.tpl.org" width="600px" padding="0" css-class="light-only" />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image src="assets/photo-family.jpg" alt="Family celebrating on a mountain overlook" href="https://www.tpl.org" width="600px" padding="0" css-class="dark-only" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
        <mj-text data-inset-toggle align="right" mj-class="caption" padding="4px 0 0">
          <span>Photograph by Photographer&rsquo;s Name, AGENCY</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- END: Image (full-bleed) -->

    <!-- START: WYSIWYG Text (inset) -->
    <mj-section
      css-class="text-block block inset-gutter"
      background-color="#ffffff" padding="0 32px" data-fully-exclude
    >
      <mj-column>
        <mj-text padding="0">
          <p>
            Dear {user_data~First Name} {user_data~Last Name},
          </p>
          <p>
            Thank you for your generous gift! Your donation of
            <strong>{receipt_data~amount~[en1]}</strong> is being processed.
          </p>
          <p>
            Please save a copy of this email to serve as your tax receipt.
            Trust for Public Land (tax identification number 23-7222333)
            has provided no goods or services in exchange for your contribution
            under applicable IRS regulations.
          </p>
          <p>
            Parks and public land are among the smartest investments we can
            make in our health, our families, and our futures. We&rsquo;re
            grateful you&rsquo;ve chosen to put that shared belief into action
            as our partner in this work.
          </p>
          <p>
            Once again, thank you for your generous support. We hope
            you&rsquo;ll visit
            <a href="https://www.tpl.org" style="color:#006837;"><strong>tpl.org</strong></a>
            often to see how your donation is connecting everyone to the
            outdoors.
          </p>
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- END: WYSIWYG Text (inset) -->

    <!-- START: Signature Card (round photo) -->
    <mj-section css-class="signature-block block" background-color="#ffffff" padding="16px 32px">
      <mj-group>
        <mj-column vertical-align="middle" width="130px" css-class="signature-img">
          <mj-image src="assets/staff-carrie-besnette-hauser.png" alt="Carrie Besnette Hauser" width="110px" padding="0 16px 0 0" border-radius="60px" css-class="light-only" />
          <mj-raw><!--[if !mso]><!--></mj-raw>
          <mj-image src="assets/staff-carrie-besnette-hauser.png" alt="Carrie Besnette Hauser" width="110px" padding="0 16px 0 0" border-radius="60px" css-class="dark-only" data-style-dark-mode />
          <mj-raw><!--<![endif]--></mj-raw>
        </mj-column>
        <mj-column vertical-align="middle" width="406px" css-class="signature-text">
          <mj-text padding="0">
            <p style="font-style:italic;font-size:15px;margin:0 0 8px;">Thank you for making this work possible.</p>
          </mj-text>
          <mj-image src="assets/staff-carrie-besnette-hauser-signature_black.png" alt="Signature" width="185px" padding="0" align="left" css-class="light-only" />
          <mj-raw><!--[if !mso]><!--></mj-raw>
          <mj-image src="assets/staff-carrie-besnette-hauser-signature_white.png" alt="Signature" width="185px" padding="0" align="left" css-class="dark-only" data-style-dark-mode />
          <mj-raw><!--<![endif]--></mj-raw>
          <mj-text data-inset-toggle padding="8px 0 0">
            <p style="font-size:17px;margin:0;"><b>Carrie Besnette Hauser</b><br /><b>President &amp; Chief Executive Officer</b></p>
          </mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <!-- END: Signature Card (round photo) -->

    <!-- START: Body Text (inset) -->
    <mj-section css-class="text-block block body-text-block inset-gutter" background-color="#ffffff" padding="16px 64px">
      <mj-column>
        <mj-text padding="0">
          <p style="font-size:16px;">
            Questions? Email
            <a href="mailto:donor.outreach@tpl.org" style="color:#006837;">donor.outreach@tpl.org</a>
            or call
            <a href="tel:800-714-5263" style="color:#006837;">1-800-714-5263</a>.
          </p>
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- END: Body Text (inset) -->

    <!-- START: Footer (w/ image) -->
    <mj-include path="./partials/tri-color-divider.mjml" />
    <mj-section css-class="footer-block block" background-color="#362229" padding="32px">
      <mj-column>
        <mj-image src="assets/text-and-arrow_2.png" href="https://tpl.org/donate" alt="Supporters like you make our work possible" width="225px" align="center" padding="0 0 8px" css-class="light-only" />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image src="assets/text-and-arrow_2.png" href="https://tpl.org/donate" alt="Supporters like you make our work possible" width="225px" align="center" padding="0 0 8px" css-class="dark-only" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
        <mj-button width="auto" color="#ffffff" background-color="#006837" href="https://tpl.org/donate" align="center" padding="0 0 32px">DONATE</mj-button>
        <mj-text color="#ffffff" align="center" data-no-display-toggle padding="0 0 16px">
          <p style="font-size:14px;line-height:21px;"><b>Connecting everyone to the outdoors.</b> We create parks and protect public land where they're needed most so that everyone will have access to the benefits and joys of the outdoors for generations to come.</p>
        </mj-text>
        <mj-text color="#ffffff" align="center" padding="0 0 16px">
          <p style="font-size:14px;line-height:21px;">Trust for Public Land is a 501(c)(3), tax-exempt organization. Copyright © 2026 Trust for Public Land. All rights reserved.</p>
          <p style="font-size:14px;line-height:21px;"><b>You are receiving this email because you made a donation to Trust for Public Land. This receipt was sent to {user_data~Email Address}.</b></p>
        </mj-text>
        <mj-image css-class="light-only" src="assets/logo-tpl_color-light-green-text.png" alt="Trust for Public Land" href="https://www.tpl.org" width="134px" align="center" padding="0 0 16px" data-no-display-toggle />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image css-class="dark-only" src="assets/logo-tpl_color-light-green-text.png" alt="Trust for Public Land" href="https://www.tpl.org" width="134px" align="center" padding="0 0 16px" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
        <mj-text color="#ffffff" align="center" data-no-display-toggle padding="0">
          <p style="font-size:14px;"><a href="https://fundraise.tpl.org/page/1000752/subscriptions/1?chain" style="color:#ffffff;" data-campaign-id="1000752" data-custom-urls="[]" data-custom-urls-enabled="false" data-name="Subscription_Management_Page" data-type="campaignpage_url_pb">Manage Subscription</a></p>
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- END: Footer (w/ image) -->

    <!-- END: Main Content -->
  </mj-body>
</mjml>

            align="left" />
          <mj-raw><!--[if !mso]><!--></mj-raw>
          <mj-image
            src="assets/logo-tpl_color-light-green-text.png"
            alt="Logo"
            href="https://tpl.org"
            width="154px"
            padding="0 16px 0 0"
            css-class="dark-only"
            align="left" data-style-dark-mode />
          <mj-raw><!--<![endif]--></mj-raw>
        </mj-column>
        <mj-column vertical-align="bottom" width="50%">
            <mj-button css-class="button fixed-width" width="auto"

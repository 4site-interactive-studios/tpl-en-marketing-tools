    <!-- START: CTA Hero (w/ image badge) -->
    <mj-section css-class="image-block block" background-color="#ffffff" border="1px solid #D9E3D9" padding="16px 32px">
      <mj-group>
        <mj-column vertical-align="middle" width="50%">
          <mj-image data-display-toggle css-class="light-only" src="assets/logo-tpl_color-black-text.png" alt="Trust for Public Land" href="https://tpl.org" width="154px" padding="0 16px 0 0" align="left" />
          <mj-raw><!--[if !mso]><!--></mj-raw>
          <mj-image css-class="dark-only" src="assets/logo-tpl_color-light-green-text.png" alt="Trust for Public Land" href="https://tpl.org" width="154px" padding="0 16px 0 0" align="left" data-style-dark-mode />
          <mj-raw><!--<![endif]--></mj-raw>
        </mj-column>
        <mj-column vertical-align="middle" width="50%">
          <mj-image css-class="light-only" src="assets/cta-giving-tuesday_color.png" alt="Placeholder graphic" href="https://tpl.org" width="163px" padding="0 0 8px" align="right" />
          <mj-raw><!--[if !mso]><!--></mj-raw>
          <mj-image css-class="dark-only" src="assets/cta-giving-tuesday_white.png" alt="Placeholder graphic" href="https://tpl.org" width="163px" padding="0 0 8px" align="right" data-style-dark-mode />
          <mj-raw><!--<![endif]--></mj-raw>
          <mj-button width="auto" href="https://tpl.org" align="right" padding="0" color="#ffffff" background-color="#006837">READ MORE</mj-button>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section css-class="spacer-block block" padding="0">
      <mj-column>
        <mj-spacer height="0px" />
      </mj-column>
    </mj-section>
    <!-- END: CTA Hero (w/ image badge) -->


    <!-- START: CTA Hero (w/ heading) -->
    <!-- The heading sat on an #F5FAF1 panel until 2026-08-21, when the panel was
         removed (user decision). Its colour went white in the same edit: the
         panel was what made Earth text legible, and photo-kayak.jpg is a DARK
         ground everywhere else in this catalog — the CTA Hero over the same
         photo uses the light-green logo for exactly that reason. -->
    <!-- Fallback colour lives on the wrapper, NOT this section: MJML copies a section background-color onto the v:fill as color=, and the Word engine then paints that instead of the photo (measured 2026-08-13, EoA aBPD6k1l — variant A slabbed, B and C rendered). Behind the section it still covers a blocked image. -->
    <mj-wrapper background-color="#362229" padding="0">
      <mj-section css-class="image-block block" background-url="assets/photo-kayak.jpg" background-size="cover" background-repeat="no-repeat" background-position="center center" padding="32px 0 32px">
        <!-- data-no-direction-toggle: this row pins its outer content to the block edge (align is physical), so reversing the columns would drag it inward — ship the mirrored arrangement as its own block (measured 2026-08-10). -->
        <mj-group data-no-direction-toggle>
          <mj-column width="32px">&nbsp;</mj-column>
          <mj-column vertical-align="top" width="240px">
            <mj-image data-display-toggle css-class="light-only" src="assets/logo-tpl_color-light-green-text.png" alt="Trust for Public Land" href="https://tpl.org" width="144px" padding="0 8px 8px 0" align="left" />
            <mj-raw><!--[if !mso]><!--></mj-raw>
            <mj-image css-class="dark-only" src="assets/logo-tpl_color-light-green-text.png" alt="Trust for Public Land" href="https://tpl.org" width="144px" padding="0 8px 8px 0" align="left" data-style-dark-mode />
            <mj-raw><!--<![endif]--></mj-raw>
          </mj-column>
          <mj-column vertical-align="top" width="296px">
            <mj-text align="center" css-class="wysiwyg caption-panel advocacy-box" padding="0">
              <h3 style="color:#ffffff;padding:12px 8px 0;">Lorem Ipsum Dolor Sit Amet</h3>
              <p style="margin:0;font-size:4px;line-height:8px;">&nbsp;</p>
            </mj-text>
            <mj-button width="auto" href="https://tpl.org" align="center" padding="0" color="#ffffff" background-color="#006837">LEARN MORE</mj-button>
          </mj-column>
          <mj-column width="32px">&nbsp;</mj-column>
        </mj-group>
      </mj-section>
    </mj-wrapper>
    <mj-section css-class="spacer-block block" padding="0">
      <mj-column>
        <mj-spacer height="16px" />
      </mj-column>
    </mj-section>
    <!-- END: CTA Hero (w/ heading) -->

    <!-- START: Category — Text Blocks -->
    <mj-raw><div data-import-exclude="true" data-folder="6400" data-category-short="Text"></mj-raw>
    <mj-section data-no-width-toggle css-class="text-block block" background-color="#000000" padding="8px 32px">
      <mj-column>
        <mj-text align="center" padding="0">
          <p style="font-size:14px;font-weight:700;letter-spacing:3px;color:#8CC63F;font-family:Menlo,Consolas,monospace;">TEXT BLOCKS</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-raw></div></mj-raw>
    <!-- END: Category — Text Blocks -->

    <!-- START: WYSIWYG Text -->
    <!-- Reduced to the body paragraph alone (user decision 2026-08-22). It
         carried a heading mj-text and a button as well; an editor who wants
         either adds the block that ships it. The paragraph is now the column's
         SOLE member, so sole-member consolidation applies: it gets no Spacing
         Below of its own and its authored padding drops to 0 — the section's
         own bottom padding is the one pacing control (conventions, "Sole-member
         consolidation"). Its second sentence still demos an inline link. -->
    <mj-section
      css-class="text-block block"
      background-color="#ffffff" padding="0 64px 16px"
    >
      <mj-column>
        <mj-text padding="0">
          <p>
            Lorem ipsum dolor sit amet consectetur. Morbi adipiscing convallis vitae
            quisque commodo volutpat ut. Cursus sed quam ornare augue quis metus.
            Fermentum sit id pharetra tortor. In viverra semper et lorem consequat
            pellentesque. Proin urna urna massa ut quis augue pulvinar senectus
            aenean. <a href="https://tpl.org">Non sit volutpat quam pretium</a>
            risus ullamcorper <a href="https://tpl.org">pretium nisi porttitor</a>.
          </p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section css-class="spacer-block block" padding="0">
      <mj-column>
        <mj-spacer height="0px" />
      </mj-column>
    </mj-section>
    <!-- END: WYSIWYG Text -->

    <!-- START: Quote Block -->
    <mj-section
      css-class="quote-block block"
      background-color="#FFFFFF" padding="32px 16px 16px"
    >
      <mj-column data-no-width-toggle width="472px" padding="0">
        <mj-image
          data-group-label="Quote Mark"
          src="assets/icon-quotes_black.png"
          alt=""
          width="47px"
          padding="0 0 32px"
          css-class="light-only" />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image
          src="assets/icon-quotes_white.png"
          alt=""
          width="47px"
          padding="0 0 32px"
          css-class="dark-only" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
        <!-- Quote and attribution are separate mj-texts so each mints its
             own Content field and the attribution gets its own Display
             toggle (user decision 2026-08-19). The quote's old internal
             16px margin moved to its padding. -->
        <mj-text data-group-label="Quote" padding="0 0 16px">
          <p style="font-size: 30px; line-height: 38px; font-weight: 400; text-align: center; font-style: italic; margin-bottom: 0;">
            Recommended character count: ~120. Lorem ipsum dolor sit amet consectetur.
            Arcu eu tincidunt amet eleifend placerat adipiscing.
          </p>
        </mj-text>
        <mj-text data-group-label="Attribution" padding="0 0 48px">
          <p style="font-size: 14px; letter-spacing: 2px; font-weight: 500; text-align: center; font-family: Arial, sans-serif; margin-bottom: 0;">
            - TESTIMONIAL AUTHOR
          </p>
        </mj-text>
        <mj-divider css-class="divider" border-width="4px" border-color="#006837" padding="0" width="280px" />
      </mj-column>
    </mj-section>
    <mj-section css-class="spacer-block block" padding="0">
      <mj-column>
        <mj-spacer height="0px" />
      </mj-column>
    </mj-section>
    <!-- END: Quote Block -->

    <!-- START: Highlighted Text -->

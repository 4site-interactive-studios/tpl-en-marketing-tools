    <!-- START: Video Block -->
    <!-- Fallback colour lives on the wrapper, NOT this section: MJML copies a section background-color onto the v:fill as color=, and the Word engine then paints that instead of the photo (measured 2026-08-13, EoA aBPD6k1l — variant A slabbed, B and C rendered). Behind the section it still covers a blocked image. -->
    <mj-wrapper background-color="#4A7A68" padding="0">
      <mj-section css-class="image-block block" background-url="assets/photo-kayak_color-overlay.jpg" background-size="cover" background-repeat="no-repeat" background-position="center center" padding="100px 0 100px">
        <mj-group>
          <mj-column width="25px">&nbsp;</mj-column>
        <mj-column width="550px">
          <mj-button width="auto" href="https://tpl.org" align="center" background-color="#4A7A68" color="#ffffff" border="2px solid #ffffff" padding="0">WATCH&nbsp;&nbsp;▷</mj-button>
        </mj-column>
          <mj-column width="25px">&nbsp;</mj-column>
        </mj-group>
      </mj-section>
    </mj-wrapper>
    <mj-section css-class="block caption" background-color="#ffffff" padding="4px 0 0">
      <mj-column vertical-align="middle">
        <!-- data-display-toggle: the caption is the SOLE member of its column,
             and a sole member earns no Display Select otherwise. The gap above
             it is the SECTION's top padding, not the text's — the video sits in
             a different section, so the caption is its column's first element
             and the pacing rule sends the gap to the frame. 4px above / 8px
             below matches the image blocks (Image 1x1, Images 2x1/3x1), where
             the image carries no bottom padding of its own. 4 is on the caption
             class's own scale ("Quarter"), which is why this reads Quarter above
             and Half below rather than an off-scale pair. -->
        <mj-text data-display-toggle align="right" mj-class="caption" padding="0 0 8px">
          <span>Video by Videographer&rsquo;s Name, AGENCY</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section css-class="spacer-block block" padding="0">
      <mj-column>
        <mj-spacer height="16px" />
      </mj-column>
    </mj-section>
    <!-- END: Video Block -->

    <!-- START: Video Block (inset) -->
    <!-- data-visible-duplicate: the inset twin of Video Block —
         same structure, framed on a white ground (user decision 2026-08-20).
         Deliberately visible alongside its anchor; never re-flag into the
         excluded family. It CANNOT collapse into one block with a padding
         Select: the centre column's fixed width is derived from the wrapper
         inset (600 - 2*32 - 50 = 486 vs 600 - 50 = 550) and MJML bakes that
         into the MSO conditional at compile time, so a padding change in EN
         would leave the column at the old width. The gutter moved 48 -> 32 on
         2026-08-21 to line up with its twin, Countdown Block; the centre column
         reuses Countdown's existing 484px class rather than minting 486px,
         which costs 2px of invisible slack and saves ~174 delivered bytes of
         head CSS against a budget with ~434 to spare. -->
    <!-- Fallback colour is on THIS wrapper, never on the section carrying the image: MJML copies a section background-color onto the v:fill as color= and the Word engine paints that instead of the photo (measured 2026-08-13, EoA aBPD6k1l — variant A slabbed, B and C rendered). This is the same wrapper(colour) > section(image) shape the CTA Heroes use. The frame is #ffffff, which is what it was always meant to be — an earlier shape nested a second wrapper to get that, which is invalid MJML, so it shipped as Earth from 2026-08-19 until the frame and the fallback were reconciled on white (2026-08-20). Anything authored OVER the photo must stay legible on white, because white is what Outlook paints when the image does not load. -->
    <mj-wrapper css-class="block" background-color="#ffffff" padding="0 64px 0">
        <mj-section css-class="image-block" background-url="assets/photo-kayak_color-overlay.jpg" background-size="cover" background-repeat="no-repeat" background-position="center center" padding="100px 0 100px">
        <mj-group>
          <mj-column width="25px">&nbsp;</mj-column>
          <mj-column width="422px">
            <mj-button width="auto" href="https://tpl.org" align="center" background-color="#4A7A68" color="#ffffff" border="2px solid #ffffff" padding="0">WATCH&nbsp;&nbsp;▷</mj-button>
          </mj-column>
          <mj-column width="25px">&nbsp;</mj-column>
        </mj-group>
    </mj-section>
    </mj-wrapper>
    <mj-section css-class="block caption" background-color="#ffffff" padding="4px 64px 0">
      <mj-column vertical-align="middle">
        <!-- data-display-toggle: the caption is the SOLE member of its column,
             and a sole member earns no Display Select otherwise. The gap above
             it is the SECTION's top padding, not the text's — the video sits in
             a different section, so the caption is its column's first element
             and the pacing rule sends the gap to the frame. 4px above / 8px
             below matches the image blocks (Image 1x1, Images 2x1/3x1), where
             the image carries no bottom padding of its own. 4 is on the caption
             class's own scale ("Quarter"), which is why this reads Quarter above
             and Half below rather than an off-scale pair. -->
        <mj-text data-display-toggle align="right" mj-class="caption" padding="0 0 8px">
          <span>Video by Videographer&rsquo;s Name, AGENCY</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section css-class="spacer-block block" padding="0">
      <mj-column>
        <mj-spacer height="16px" />
      </mj-column>
    </mj-section>
    <!-- END: Video Block (inset) -->


        <mj-image
          src="assets/logo-tpl_all-light-green.png"
          alt="Logo"
          href="https://tpl.org"
          width="154px"
          css-class="dark-only" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
      </mj-column>
    </mj-section>
    <mj-section css-class="spacer-block block" padding="0">
      <mj-column>
        <mj-spacer height="0px" />
      </mj-column>
    </mj-section>
    <!-- END: Logo Hero -->


    <!-- START: Logo Hero (w/ image) -->
    <mj-section
      css-class="image-block block"
      background-color="#006837" padding="16px 32px"
    >
      <mj-group>
      <mj-column vertical-align="middle" width="50%">
        <mj-image data-display-toggle
          src="assets/logo-tpl_all-light-green.png"
          alt="Logo"

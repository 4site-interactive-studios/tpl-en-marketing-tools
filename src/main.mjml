          <mj-raw><!--[if !mso]><!--></mj-raw>
          <mj-image src="assets/icon-thumbs-up.png" alt="" width="24px" align="left" padding="0 32px 0 0" css-class="dark-only" data-style-dark-mode />
          <mj-raw><!--<![endif]--></mj-raw>

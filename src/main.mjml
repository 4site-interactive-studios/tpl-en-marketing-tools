    <!-- START: Progress Meter Block -->
    <!-- Fallback colour lives on the wrapper, NOT this section: MJML copies a section background-color onto the v:fill as color=, and the Word engine then paints that instead of the photo (measured 2026-08-13, EoA aBPD6k1l — variant A slabbed, B and C rendered). Behind the section it still covers a blocked image. -->
    <mj-wrapper background-color="#006837" padding="0">
      <mj-section css-class="image-block block" background-url="assets/photo-forest.jpg" background-size="cover" background-repeat="no-repeat" background-position="center center" padding="32px 0 32px">
        <mj-group>
          <mj-column width="64px">&nbsp;</mj-column>
        <mj-column width="472px">
          <mj-text align="center" color="#CEE4C5" padding="0 0 8px">
            <p style="font-size:16px;font-weight:700;letter-spacing:2px;margin:0;">DEADLINE DAY</p>
          </mj-text>
          <mj-text align="center" padding="0 0 16px">
            <h2 style="color:#ffffff;margin:0;">Lorem Ipsum Dolor Sit Amet</h2>
          </mj-text>
          <mj-text color="#ffffff" padding="0 0 8px">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;">
              <tr>
                <td align="left" style="padding-right:12px;">
                  <p style="font-size:11px;font-weight:700;letter-spacing:1px;color:#ffffff;margin:0;">GOAL</p>
                  <p style="font-size:18px;font-weight:700;color:#8CC63F;margin:0;">$600,000</p>
                </td>
                <td align="left" style="padding-right:12px;">
                  <p style="font-size:11px;font-weight:700;letter-spacing:1px;color:#ffffff;margin:0;">RAISED</p>
                  <p style="font-size:18px;font-weight:700;color:#8CC63F;margin:0;">$400,500</p>
                </td>
                <td align="left" style="border-left:1px solid #ffffff;padding-left:12px;">
                  <p style="font-size:11px;font-weight:700;letter-spacing:1px;color:#ffffff;margin:0;">REMAINING</p>
                  <p style="font-size:18px;font-weight:700;color:#F7931E;margin:0;">$200,000</p>
                </td>
                <td width="30%">&nbsp;</td>
              </tr>
            </table>
          </mj-text>
          <mj-text padding="0 0 32px">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-radius:8px;border-collapse:separate;">
              <tr>
                <td width="66%" bgcolor="#39B54A" style="height:14px;font-size:0;line-height:0;border-radius:8px 0 0 8px;">&nbsp;</td>
                <td width="34%" bgcolor="#ffffff" style="height:14px;font-size:0;line-height:0;border-radius:0 8px 8px 0;">&nbsp;</td>
              </tr>

    <mj-section css-class="text-block block" background-color="#CEE4C5" padding="16px 64px">
      <mj-column>
        <mj-text padding="0 0 16px">
          <h3 style="text-align:center;">How many miles of creeks and headwaters are protected in Tualatin Mountain Forest?</h3>
        </mj-text>
        <mj-text css-class="button" padding="0">
          <!--[if mso]><table role="presentation" align="center" cellpadding="0" cellspacing="0" border="0"><tr><td bgcolor="#006837" width="136" style="width:136px;border-radius:100px;mso-padding-alt:12px 0;text-align:center;" valign="middle"><![endif]-->

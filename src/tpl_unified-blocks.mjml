<mjml lang="en">
  <mj-head>
    <!-- en-tools-config {
      "spacingScale": { "None": 0, "Half": 8, "Single": 16, "Double": 32, "Triple": 48, "Quadruple": 64 },
      "classSpacingScales": {
        "caption": { "None": 0, "Quarter": 4, "Half": 8, "Single": 16, "Double": 32, "Triple": 48, "Quadruple": 64 },
        "hero-reveal": { "None": 0, "Half": 8, "Single": 16, "Double": 32, "Triple": 48, "Quadruple": 64, "100": 100, "150": 150, "200": 200, "250": 250, "300": 300, "350": 350, "400": 400, "450": 450, "500": 500 }
      },
      "widthPresets": { "Full Bleed": 0, "Single": 16, "Double": 32, "Triple": 48, "Quadruple": 64 },
      "geometryReachPx": 64,
      "brandColors": { "Snow": "#F5FAF1", "Moss": "#CEE4C5", "Earth": "#362229", "Evergreen": "#006837", "Fern": "#39B54A", "Grass": "#8CC63F", "Sky": "#5DD8D8", "Sun": "#F7931E", "Light Grey": "#FAFAFA" }
    } -->
    <mj-breakpoint width="600px" />
    <mj-title>TPL Email Template — Block Catalog</mj-title>
    <!-- No mj-preview: EN injects its own hidden preheader from each email's Preview Text setting (measured 2026-08-10) — a template-baked one would double up in inbox snippets. Autoresponder sources (donation-thank-you) keep theirs; they do not go out through Marketing Tools broadcasts. -->

    <!-- Baseline everything inherits -->
    <mj-attributes>
      <mj-text
        color="#000000"
        font-size="18px"
        font-weight="400"
        font-family="Tahoma, sans-serif"
        line-height="24px"
        css-class="wysiwyg"
      />
      <mj-button width="auto"
        css-class="button"
        font-size="18px"
        font-weight="700"
        font-family="Tahoma, sans-serif"
        line-height="25px"
        border-radius="100px"
        inner-padding="12px 16px"
        letter-spacing="1px"
        color="#ffffff"
        background-color="#006837"
      />
      <mj-image
        padding="0" />

      <!-- Reusable variants — apply with mj-class="*" -->
      <mj-class
        name="caption"
        font-size="10px"
        line-height="16px"
        padding="4px 0 0 0"
      />
    </mj-attributes>

    <!-- No mj-style @media blocks here: EN merges same-condition @media
         blocks into the FIRST occurrence's position (measured 2026-08-19,
         EoA delivered heads), so a 599px block in this head would drag
         styles.css's 599px rules ahead of the order-dependent hides that
         precede them there. All mobile rules live in styles.css. -->

    <mj-raw>
      <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" />
      <meta name="format-detection" content="telephone=no" />
    </mj-raw>
    <!-- Marketing Tools builder bands. The data-en-tools-band attribute keeps
         this sheet in the template HEAD: the importer splices every other
         style element out into the Template Styles block, and this layout has
         to survive an email built without that block. __TEMPLATE_VERSION__ is
         filled in at import from versions.json; keeping the literal here is
         what stops the version from feeding its own hash.

         TWO SEPARATE RULES, DELIBERATELY NOT MERGED INTO ONE SELECTOR LIST.

         BLOCK bands hang off a span the app injects into the block's own
         content, gated on whether a block wrapper exists anywhere in the
         document — true while editing in EN, false in a delivered email.

         The TEMPLATE band hangs off EN's container element instead. A span
         authored in the template shell does NOT work (measured 2026-08-20):
         EN's builder renders blocks inside the container and does not render
         the template's own surrounding markup, so such a span never enters
         the builder DOM at all. [data-container="main"] IS that container,
         and it is self-gating — the stored template carries EN's container
         placeholder there and a delivered email carries the blocks
         themselves, so nothing bears the attribute outside the editor.

         Do NOT write EN's container merge tag literally anywhere in this
         file. autoEnableTemplateReplacements splits the shell on the FIRST
         occurrence of that tag, so a literal in a comment splits the head at
         the comment instead of at the real container: the comment loses its
         terminator, swallows the whole stylesheet, and every light/dark image
         pair renders both halves. Measured 2026-08-20; check-catalog guards it.

         Merging the two selectors would be a live hazard: one unsupported
         selector in a group invalidates the WHOLE rule, so a client that
         cannot parse :has() would take the template band down with it. -->
    <mj-raw>
      <style type="text/css" data-en-tools-band>
        :is(body):has(.en__emailbuilder__block) .marketing-tools-banner{
          display: flex !important;
          height: 50px;
          width: 100%;
          background-color: #000000;
          justify-content: center;
          align-items: center;
          font-weight: 700;
          font-family: sans-serif;
          color: #ffffff;
        }
        [data-container="main"]:before{
          content: "Email Template v__TEMPLATE_VERSION__";
          display: flex !important;
          height: 100px;
          width: 100%;
          background-color: #000000;
          flex-wrap: wrap;
          justify-content: center;
          align-items: center;
          max-height: 50px;
          font-weight: 700;
          font-family: sans-serif;
          color: #ffffff;
        }
      </style>
    </mj-raw>

    <mj-include path="./styles.css" type="css" />
  </mj-head>
  <mj-body css-class="email-body" background-color="#ffffff">

    <mj-include path="./partials/debug-toolbar.mjml" />

    <!-- START: Main Content -->

    <!-- START: Category — Headers and Heroes -->
    <mj-raw><div data-import-exclude="true" data-folder="6399" data-category-short="Headers/Heroes"></mj-raw>
    <mj-section data-no-width-toggle css-class="text-block block" background-color="#000000" padding="8px 32px">
      <mj-column>
        <mj-text align="center" padding="0">
          <p style="font-size:14px;font-weight:700;letter-spacing:3px;color:#8CC63F;font-family:Menlo,Consolas,monospace;">HEADERS AND HEROES</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-raw></div></mj-raw>
    <!-- END: Category — Headers and Heroes -->

    <!-- START: Logo Hero (white, w/ dark-mode swap) -->
    <mj-section
      css-class="image-block block"
      background-color="#ffffff" padding="16px 32px" data-no-width-toggle
    >
      <mj-column vertical-align="middle">
        <mj-image
          src="assets/logo-tpl_color-black-text.png"
          alt="Logo"
          href="https://www.example.com"
          width="154px"
          css-class="light-only" />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image
          src="assets/logo-tpl_all-light-green.png"
          alt="Logo"
          href="https://www.example.com"
          width="154px"
          css-class="dark-only" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
      </mj-column>
    </mj-section>
    <!-- END: Logo Hero (white, w/ dark-mode swap) -->

    <!-- START: Logo Hero (light green, w/ dark-mode swap) -->
    <mj-section
      css-class="image-block block"
      background-color="#F5FAF1" padding="16px 32px" data-fully-exclude
    >
      <mj-column vertical-align="middle">
        <mj-image
          src="assets/logo-tpl_color-black-text.png"
          alt="Logo"
          href="https://www.example.com"
          width="154px"
          css-class="light-only" />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image
          src="assets/logo-tpl_all-light-green.png"
          alt="Logo"
          href="https://www.example.com"
          width="154px"
          css-class="dark-only" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
      </mj-column>
    </mj-section>
    <!-- END: Logo Hero (light green, w/ dark-mode swap) -->

    <!-- START: Logo Hero (w/ image, green) -->
    <mj-section
      css-class="image-block block"
      background-color="#006837" padding="16px 32px"
    >
      <mj-group>
      <mj-column vertical-align="middle" width="50%">
        <mj-image
          src="assets/logo-tpl_all-light-green.png"
          alt="Logo"
          href="https://www.example.com"
          width="154px"
          padding="0 16px 0 0"
          css-class="light-only"
          align="left" />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image
          src="assets/logo-tpl_all-light-green.png"
          alt="Logo"
          href="https://www.example.com"
          width="154px"
          padding="0 16px 0 0"
          css-class="dark-only"
          align="left" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
      </mj-column>
      <mj-column vertical-align="middle" width="50%">
        <mj-text align="right" color="#ffffff" padding="0 0 8px">
          <p style="font-size:12px;line-height:14px;margin:0;">North Carolina</p>
        </mj-text>
        <mj-image
          src="assets/state-north-carolina.png"
          alt="Logo"
          href="https://www.example.com"
          width="104px"
          padding="0 0 0 16px"
          css-class="light-only"
          align="right" data-mobile-only-inset-left />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image
          src="assets/state-north-carolina.png"
          alt="Logo"
          href="https://www.example.com"
          width="104px"
          padding="0 0 0 16px"
          css-class="dark-only"
          align="right" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
      </mj-column>
      </mj-group>
    </mj-section>
    <!-- END: Logo Hero (w/ image, green) -->

    <!-- START: CTA Hero (green button) -->
    <mj-section
      css-class="image-block block"
      background-color="#362229" padding="16px 32px"
    >
      <mj-group>
      <mj-column vertical-align="middle" width="50%">
        <mj-image
          src="assets/logo-tpl_all-light-green.png"
          alt="Logo"
          href="https://www.example.com"
          width="154px"
          padding="0 16px 0 0"
          css-class="light-only"
          align="left" />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image
          src="assets/logo-tpl_color-light-green-text.png"
          alt="Logo"
          href="https://www.example.com"
          width="154px"
          padding="0 16px 0 0"
          css-class="dark-only"
          align="left" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
      </mj-column>
      <mj-column vertical-align="middle" width="50%">
          <mj-button width="auto"
            href="https://www.example.com"
            align="right" padding="0" color="#ffffff" background-color="#006837">
            READ MORE
          </mj-button>
      </mj-column>
      </mj-group>
    </mj-section>
    <!-- END: CTA Hero (green button) -->

    <!-- START: CTA Hero (logo and background image) -->
    <!-- Fallback colour lives on the wrapper, NOT this section: MJML copies a section background-color onto the v:fill as color=, and the Word engine then paints that instead of the photo (measured 2026-08-13, EoA aBPD6k1l — variant A slabbed, B and C rendered). Behind the section it still covers a blocked image. -->
    <mj-wrapper background-color="#362229" padding="0">
      <mj-section
        css-class="image-block block"
        background-url="assets/photo-kayak.jpg"
        background-size="cover"
        background-repeat="no-repeat"
        background-position="center center" padding="16px 32px 16px"
      >
        <mj-group>
        <mj-column vertical-align="middle" width="50%">
          <mj-image
            src="assets/logo-tpl_color-light-green-text.png"
            alt="Logo"
            href="https://www.example.com"
            width="154px"
            padding="0 16px 0 0"
            css-class="light-only"
            align="left" />
          <mj-raw><!--[if !mso]><!--></mj-raw>
          <mj-image
            src="assets/logo-tpl_color-light-green-text.png"
            alt="Logo"
            href="https://www.example.com"
            width="154px"
            padding="0 16px 0 0"
            css-class="dark-only"
            align="left" data-style-dark-mode />
          <mj-raw><!--<![endif]--></mj-raw>
        </mj-column>
        <mj-column vertical-align="middle" width="50%">
            <mj-button css-class="button fixed-width" width="auto"
              href="https://www.example.com"
              align="right" padding="0" color="#ffffff" background-color="#006837">
              READ MORE
            </mj-button>
        </mj-column>
        </mj-group>
      </mj-section>
    </mj-wrapper>
    <!-- END: CTA Hero (logo and background image) -->

    <!-- START: CTA Hero (centered w/ background image, fixed height) -->
    <!-- Fallback colour lives on the wrapper, NOT this section: MJML copies a section background-color onto the v:fill as color=, and the Word engine then paints that instead of the photo (measured 2026-08-13, EoA aBPD6k1l — variant A slabbed, B and C rendered). Behind the section it still covers a blocked image. -->
    <mj-wrapper background-color="#362229" padding="0">
      <mj-section
        css-class="image-block block"
        background-url="assets/photo-trail.jpg"
        background-size="cover"
        background-repeat="no-repeat"
        background-position="center center" padding="264px 32px 16px" data-fully-exclude
      >
        <mj-group>
        <mj-column vertical-align="bottom" width="50%">
          <mj-image
            src="assets/logo-tpl_color-light-green-text.png"
            alt="Logo"
            href="https://www.example.com"
            width="154px"
            padding="0 16px 0 0"
            css-class="light-only"
            align="left" />
          <mj-raw><!--[if !mso]><!--></mj-raw>
          <mj-image
            src="assets/logo-tpl_color-light-green-text.png"
            alt="Logo"
            href="https://www.example.com"
            width="154px"
            padding="0 16px 0 0"
            css-class="dark-only"
            align="left" data-style-dark-mode />
          <mj-raw><!--<![endif]--></mj-raw>
        </mj-column>
        <mj-column vertical-align="bottom" width="50%">
            <mj-button css-class="button fixed-width" width="auto"
              href="https://www.example.com"
              align="right" padding="0" color="#ffffff" background-color="#006837">
              READ MORE
            </mj-button>
        </mj-column>
        </mj-group>
      </mj-section>
    </mj-wrapper>
    <!-- END: CTA Hero (centered w/ background image, fixed height) -->

    <!-- START: CTA Hero (w/ large background image) -->
    <!--
      Inside a section using a background all elements must have 0 left
      and right padding or they will be misaligned on outlook.
      This is why we use spacer columns with a fixed width on the sides
      of the overlay image column to create the necessary padding while
      maintaining alignment across email clients.
     -->
    <!-- Fallback colour lives on the wrapper, NOT this section: MJML copies a section background-color onto the v:fill as color=, and the Word engine then paints that instead of the photo (measured 2026-08-13, EoA aBPD6k1l — variant A slabbed, B and C rendered). Behind the section it still covers a blocked image. -->
    <mj-wrapper background-color="#000000" padding="0">
      <mj-section
          css-class="overlay-image-block block hero-reveal" background-url="assets/photo-person_overlay.jpg"
          background-size="cover"
          background-repeat="no-repeat"
          background-position="center bottom" padding="350px 32px 48px"
      >
        <mj-group>

          <mj-column>
            <mj-text css-class="overlay" padding="0 32px 8px">
              <h1 style="text-align: center">Placeholder message for special occasion </h1>
            </mj-text>
            <mj-button css-class="button fixed-width" width="auto"
              href="https://www.example.com" padding="0 32px 8px" color="#ffffff" background-color="#006837">
              BUTTON
            </mj-button>
          </mj-column>
        </mj-group>
      </mj-section>
    </mj-wrapper>
    <!-- END: CTA Hero (w/ large background image) -->

    <!-- START: Category — Text Blocks -->
    <mj-raw><div data-import-exclude="true" data-folder="6400" data-category-short="Text"></mj-raw>
    <mj-section data-no-width-toggle css-class="text-block block" background-color="#000000" padding="8px 32px">
      <mj-column>
        <mj-text align="center" padding="0">
          <p style="font-size:14px;font-weight:700;letter-spacing:3px;color:#8CC63F;font-family:Menlo,Consolas,monospace;">TEXT BLOCKS</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-raw></div></mj-raw>
    <!-- END: Category — Text Blocks -->

    <!-- START: WYSIWYG Text (full width) -->
    <mj-section
      css-class="text-block block"
      background-color="#ffffff" padding="0 32px"
    >
      <mj-column>
        <!-- Heading and body are separate mj-texts so each mints its own
             Content field and Display toggle, and the heading's level is
             editable via data-heading-level-toggle (user decisions
             2026-08-19). The old second, LINKED heading demo is gone; the
             body's second paragraph still demos an inline link. The
             heading stays on one line: the narrowed Content field's value
             is matched by text search in the compiled HTML. -->
        <mj-text data-heading-level-toggle padding="0 0 16px">
          <h2>Lorem ipsum quis malesuada sed quam faucibus.</h2>
        </mj-text>
        <mj-text padding="0">
          <p>
            Lorem ipsum dolor sit amet consectetur. Morbi adipiscing convallis vitae
            quisque commodo volutpat ut. Cursus sed quam ornare augue quis metus.
            Fermentum sit id pharetra tortor. In viverra semper et lorem consequat
            pellentesque. Proin urna urna massa ut quis augue pulvinar senectus aenean.
            Non sit volutpat quam pretium risus ullamcorper pretium nisi porttitor.
          </p>
          <p>
            Lorem ipsum dolor sit amet consectetur. Morbi adipiscing convallis
            vitae quisque commodo volutpat ut. Cursus sed quam ornare augue quis
            metus. Fermentum sit id pharetra tortor. In viverra semper et lorem
            consequat pellentesque. Proin urna urna massa ut quis augue pulvinar
            senectus aenean. <a href="https://www.example.com">Non sit volutpat quam pretium risus ullamcorper pretium
            nisi porttitor.</a>
          </p>
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- END: WYSIWYG Text (full width) -->

    <!-- START: WYSIWYG Text (inset) -->
    <mj-section
      css-class="text-block block inset-gutter"
      background-color="#ffffff" padding="0 32px" data-fully-exclude
    >
      <mj-column>
        <!-- Heading and body are separate mj-texts so each mints its own
             Content field and Display toggle, and the heading's level is
             editable via data-heading-level-toggle (user decisions
             2026-08-19). The old second, LINKED heading demo is gone; the
             body's second paragraph still demos an inline link. The
             heading stays on one line: the narrowed Content field's value
             is matched by text search in the compiled HTML. -->
        <mj-text data-heading-level-toggle padding="0 0 16px">
          <h2>Lorem ipsum quis malesuada sed quam faucibus.</h2>
        </mj-text>
        <mj-text padding="0">
          <p>
            Lorem ipsum dolor sit amet consectetur. Morbi adipiscing convallis vitae
            quisque commodo volutpat ut. Cursus sed quam ornare augue quis metus.
            Fermentum sit id pharetra tortor. In viverra semper et lorem consequat
            pellentesque. Proin urna urna massa ut quis augue pulvinar senectus aenean.
            Non sit volutpat quam pretium risus ullamcorper pretium nisi porttitor.
          </p>
          <p>
            Lorem ipsum dolor sit amet consectetur. Morbi adipiscing convallis
            vitae quisque commodo volutpat ut. Cursus sed quam ornare augue quis
            metus. Fermentum sit id pharetra tortor. In viverra semper et lorem
            consequat pellentesque. Proin urna urna massa ut quis augue pulvinar
            senectus aenean. <a href="https://www.example.com">Non sit volutpat quam pretium risus ullamcorper pretium
            nisi porttitor.</a>
          </p>
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- END: WYSIWYG Text (inset) -->

    <!-- START: Quote Block -->
    <mj-section
      css-class="quote-block block"
      background-color="#FFFFFF" padding="32px 16px 0"
    >
      <mj-column data-no-width-toggle width="480px" padding="0">
        <mj-image
          data-group-label="Quote Mark"
          src="assets/icon-quotes_black.png"
          alt=""
          width="47px"
          padding="0 0 32px"
          css-class="light-only" />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image
          data-group-label="Quote Mark"
          src="assets/icon-quotes_white.png"
          alt=""
          width="47px"
          padding="0 0 32px"
          css-class="dark-only" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
        <!-- Quote and attribution are separate mj-texts so each mints its
             own Content field and the attribution gets its own Display
             toggle (user decision 2026-08-19). The quote's old internal
             16px margin moved to its padding. -->
        <mj-text data-group-label="Quote" padding="0 0 16px">
          <p style="font-size: 30px; line-height: 38px; font-weight: 400; text-align: center; font-style: italic; margin-bottom: 0;">
            Recommended character count: ~120. Lorem ipsum dolor sit amet consectetur.
            Arcu eu tincidunt amet eleifend placerat adipiscing.
          </p>
        </mj-text>
        <mj-text data-group-label="Attribution" padding="0 0 48px">
          <p style="font-size: 14px; letter-spacing: 2px; font-weight: 500; text-align: center; font-family: Arial, sans-serif; margin-bottom: 0;">
            - TESTIMONIAL AUTHOR
          </p>
        </mj-text>
        <mj-divider css-class="divider" border-width="4px" border-color="#006837" padding="0" width="280px" />
      </mj-column>
    </mj-section>
    <!-- END: Quote Block -->

    <!-- START: Highlighted Text -->
    <mj-section
      css-class="text-block block"
      background-color="#ffffff" padding="16px"
    >
      <mj-column data-no-width-toggle css-class="highlighted-text-column" width="480px" border-left="4px solid #006837" background-color="#CEE4C5" padding="16px 16px 0">
        <mj-text padding="0 0 16px">
          <p style="font-family: Arial, sans-serif;">
            Lorem ipsum dolor sit amet consectetur. Morbi adipiscing convallis vitae
            quisque commodo volutpat ut. Cursus sed quam ornare augue quis metus.
            Fermentum sit id pharetra tortor.
          </p>
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- END: Highlighted Text -->

    <!-- START: CTA Text Block -->
    <mj-section
      css-class="block"
      background-color="#CEE4C5" padding="16px"
    >
      <mj-column data-no-width-toggle width="480px" padding="0">
        <!-- Heading and body are separate mj-texts so each mints its own
             Content field and Display toggle (one idea per mj-text,
             user decision 2026-08-19). -->
        <mj-text align="center" padding="0 0 16px">
          <h3>Lorem ipsum dolor</h3>
        </mj-text>
        <mj-text align="center" padding="0 0 32px">
          <p style="font-family: Arial, sans-serif;">
            Lorem ipsum dolor sit amet consectetur. Diam venenatis lectus nisi quam nibh at
            donec adipiscing ornare. Pellentesque nibh morbi pulvinar quis viverra.
          </p>
        </mj-text>
        <mj-button width="auto"
            color="#ffffff"
            background-color="#006837"
            href="https://www.example.com"
            align="center" padding="0 32px 8px">
          LOREM IPSUM SEMPER MI
        </mj-button>
      </mj-column>
    </mj-section>
    <!-- END: CTA Text Block -->

    <!-- START: Linked Header Row (w/ icon) -->
    <mj-section
      css-class="text-block block header-row-block"
      background-color="#CEE4C5" padding="16px 32px"
    >
      <mj-column vertical-align="middle">
        <mj-text data-heading-level-toggle padding="0">
          <h2>🦋&nbsp; <a href="https://www.example.com">Lorem Ipsum Dolor Sit Amet</a></h2>

    <!-- START: Question Block -->
    <mj-section
      css-class="text-block block"
      background-color="#ffffff" padding="0 32px"
    >
      <mj-column padding="0">
        <mj-text css-class="question-response" padding="0">
          <!-- EN auto-closes an <a> that wraps a <table> (measured 2026-08-18,
               probe 0Mgmjr - the row anchor arrived EMPTY and nothing was
               clickable), so the row link is per-cell anchors sharing ONE URL
               field via data-link-group: same group + byte-identical hrefs =
               one replacement spliced into every member, nothing to desync.
               The copy anchor carries data-text-anchor so its Label/Text
               Color group as Text, not "Button 2", and authors a concrete
               #000000 (renders identically to the old inherit) so the color
               mints a palette Select (user decisions 2026-08-19). -->
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;">
            <tr>
              <td valign="top" style="width:33px;padding:16px 0px 0px 0px;">
                <a href="https://www.example.com" data-link-group="row" data-group-label="Row Link" style="display:block;"><img src="assets/icon-circle.png" alt="" width="18" height="18" style="display:block;width:18px;height:18px;border:0;" /></a>
              </td>
              <td valign="top" style="padding:8px 0px 12px 0px;">
                <p style="margin:0;"><a href="https://www.example.com" data-link-group="row" data-text-anchor data-group-label="Row Copy" style="display:block;text-decoration:none;color:#000000;">Each list item will function as a link in the email directing users to a dedicated page on your site.</a></p>
              </td>
            </tr>
          </table>
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- END: Question Block -->


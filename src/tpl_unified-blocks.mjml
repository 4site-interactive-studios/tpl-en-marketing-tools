        <mj-image src="assets/photo-couple-on-water.jpg" alt="Older couple relaxing in chairs by the water" href="https://www.example.com" width="248px" align="center" padding="0 0 16px" border="3px solid #39B54A" border-radius="18px" css-class="inline-fluid light-only" />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image src="assets/photo-couple-on-water.jpg" alt="Older couple relaxing in chairs by the water" href="https://www.example.com" width="248px" align="center" padding="0 0 16px" border="3px solid #39B54A" border-radius="18px" css-class="inline-fluid dark-only" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
        <mj-text css-class="wysiwyg quiz-cta" align="center" padding="0 0 16px">
          <a href="https://www.example.com">AGES 65+</a>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section css-class="text-block block" background-color="#362229" padding="0 32px 16px">
      <mj-column>
        <mj-text css-class="wysiwyg link-inverse" color="#ffffff" padding="0 0 8px">
          <p style="font-size:16px;">Not in a guessing mood? <a href="https://www.example.com"><strong>Skip to the answer.</strong></a></p>
        </mj-text>
        <mj-text data-inset-toggle data-mobile-only-inset-left align="right" mj-class="caption" color="#ffffff" padding="0">
          <span>Photos: Bergreen Photography, Chris Bennett, Caroline Martin, Sara Rubinstein</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- END: Quiz Block (2x2 photos) -->

    <!-- START: Feedback Poll Block -->
    <!-- The QA'd decomposed shape (swapped in 2026-08-18, replacing the
         pre-QA monolith): question section + one answer-row section per
         answer, matching the library's stackable Feedback Poll Option.
         This template block ships the three-answer default as ONE block;
         to vary the answer count in a send, stack the library's Feedback
         Poll Option block instead. -->
    <!-- data-mobile-only-padding-right: the one-line question leaves the right
         padding nothing to move at 600px (left-aligned copy, white ground) —
         the audit measures it live at 375 only. If real question copy ever
         wraps at desktop, the control comes alive there: drop the flag then. -->
    <mj-section css-class="poll-block block" background-color="#ffffff" padding="16px 32px 8px" data-mobile-only-padding-right>
      <mj-column>
        <mj-text padding="0">
          <p style="font-size:17px;font-weight:700;">Lorem ipsum dolor sit amet consectetur adipiscing elit?</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section css-class="poll-block block" background-color="#ffffff" padding="0 32px 8px">
      <mj-group>
        <mj-column width="56px" vertical-align="middle" css-class="poll-icon">
          <mj-image src="assets/icon-heart_green.png" alt="" width="24px" align="left" padding="0 32px 0 0" css-class="light-only" />
          <mj-raw><!--[if !mso]><!--></mj-raw>
          <mj-image src="assets/icon-heart_green.png" alt="" width="24px" align="left" padding="0 32px 0 0" css-class="dark-only" data-style-dark-mode />
          <mj-raw><!--<![endif]--></mj-raw>
        </mj-column>
        <mj-column width="480px" vertical-align="middle" css-class="poll-text">
          <mj-text padding="0">
            <p style="font-size:16px;"><a href="https://www.example.com"><strong>Very important</strong></a></p>
          </mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section css-class="poll-block block" background-color="#ffffff" padding="0 32px 8px">
      <mj-group>
        <mj-column width="56px" vertical-align="middle" css-class="poll-icon">
          <mj-image src="assets/icon-thumbs-up.png" alt="" width="24px" align="left" padding="0 32px 0 0" css-class="light-only" />
          <mj-raw><!--[if !mso]><!--></mj-raw>
          <mj-image src="assets/icon-thumbs-up.png" alt="" width="24px" align="left" padding="0 32px 0 0" css-class="dark-only" data-style-dark-mode />
          <mj-raw><!--<![endif]--></mj-raw>
        </mj-column>
        <mj-column width="480px" vertical-align="middle" css-class="poll-text">
          <mj-text padding="0">
            <p style="font-size:16px;"><a href="https://www.example.com"><strong>Somewhat important</strong></a></p>
          </mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section css-class="poll-block block" background-color="#ffffff" padding="0 32px 16px">
      <mj-group>
        <mj-column width="56px" vertical-align="middle" css-class="poll-icon">
          <mj-image src="assets/icon-prohibited.png" alt="" width="24px" align="left" padding="0 32px 0 0" css-class="light-only" />
          <mj-raw><!--[if !mso]><!--></mj-raw>
          <mj-image src="assets/icon-prohibited.png" alt="" width="24px" align="left" padding="0 32px 0 0" css-class="dark-only" data-style-dark-mode />
          <mj-raw><!--<![endif]--></mj-raw>
        </mj-column>
        <mj-column width="480px" vertical-align="middle" css-class="poll-text">
          <mj-text padding="0">
            <p style="font-size:16px;"><a href="https://www.example.com"><strong>Not important</strong></a></p>
          </mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <!-- END: Feedback Poll Block -->

    <!-- START: Category — Utilities -->
    <mj-raw><div data-import-exclude="true" data-folder="6409" data-category-short="Utility"></mj-raw>
    <mj-section data-no-width-toggle css-class="text-block block" background-color="#000000" padding="8px 32px">
      <mj-column>
        <mj-text align="center" padding="0">
          <p style="font-size:14px;font-weight:700;letter-spacing:3px;color:#8CC63F;font-family:Menlo,Consolas,monospace;">UTILITIES</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-raw></div></mj-raw>
    <!-- END: Category — Utilities -->

    <!-- START: Spacer -->
    <mj-section css-class="spacer-block block" padding="0">
      <mj-column>
        <mj-spacer height="16px" container-background-color="#ffffff" />
      </mj-column>
    </mj-section>
    <!-- END: Spacer -->

    <!-- START: Divider (Single-color) -->
    <mj-section css-class="divider-block block" background-color="#ffffff" padding="16px 0" data-mobile-only-width>
      <mj-column>
        <mj-divider
          css-class="divider"
          border-width="3px"
          border-color="#006837"
          padding="0"
          width="300px"
          data-width-options="50,100,150,200,250,300,350,400,450,500,550,600"
        />
      </mj-column>
    </mj-section>
    <!-- END: Divider (Single-color) -->

    <!-- START: Divider (Tri-color) -->
    <mj-include path="./partials/tri-color-divider.mjml" />
    <!-- END: Divider (Tri-color) -->

    <!-- START: Category — Signatures -->
    <mj-raw><div data-import-exclude="true" data-folder="6404" data-category-short="Signature"></mj-raw>
    <mj-section data-no-width-toggle css-class="text-block block" background-color="#000000" padding="8px 32px">
      <mj-column>
        <mj-text align="center" padding="0">
          <p style="font-size:14px;font-weight:700;letter-spacing:3px;color:#8CC63F;font-family:Menlo,Consolas,monospace;">SIGNATURES</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-raw></div></mj-raw>
    <!-- END: Category — Signatures -->

    <!-- START: Signature Card (square photo) -->
    <mj-section css-class="signature-block block" background-color="#ffffff" padding="16px 32px 0">
      <mj-column>
        <mj-text padding="0">
          <p style="font-style: italic;">
            With deep appreciation,
          </p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section css-class="signature-block block" background-color="#ffffff" padding="16px 32px">
      <mj-group>
        <mj-column
          vertical-align="top"
          width="110px"
          css-class="signature-img" padding="0 8px 0 0">
          <mj-image
              src="assets/staff-carrie-besnette-hauser.png" width="100px" align="left"
              alt="Carrie Besnette Hauser" border-radius="0" data-image-shape-toggle
              padding="0" css-class="light-only" />
          <mj-raw><!--[if !mso]><!--></mj-raw>
          <mj-image
              src="assets/staff-carrie-besnette-hauser.png" width="100px" align="left"
              alt="Carrie Besnette Hauser" border-radius="0" data-image-shape-toggle
              padding="0" css-class="dark-only" data-style-dark-mode />
          <mj-raw><!--<![endif]--></mj-raw>
        </mj-column>
        <mj-column
          vertical-align="middle"
          width="426px"
          css-class="signature-text" padding="0 0 0 8px">
          <mj-image
              src="assets/staff-carrie-besnette-hauser-signature_black.png"
              alt="Signature"
              width="234px"
             padding="0"
              align="left"
              css-class="light-only" />
          <mj-raw><!--[if !mso]><!--></mj-raw>
          <mj-image
              src="assets/staff-carrie-besnette-hauser-signature_white.png"
              alt="Signature"
              width="234px"
             padding="0"
              align="left"
              css-class="dark-only" data-style-dark-mode />
          <mj-raw><!--<![endif]--></mj-raw>
          <mj-text data-inset-toggle data-mobile-only-inset-right font-size="16px" padding="8px 0 0">
            <p style="font-family: Arial, sans-serif;">
              Carrie Besnette-Hauser
              <br />
              <em style="font-family: Georgia, serif;">Placeholder title, Example Division</em>
              <br />
              <b>Trust for Public Land</b>
            </p>
          </mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <!-- END: Signature Card (square photo) -->

    <!-- START: Signature Card (no photo) -->
    <mj-section css-class="signature-block block" background-color="#ffffff" padding="16px 32px">
      <mj-column>
        <mj-text padding="0">
          <p style="font-style:italic;font-size:15px;margin:0 0 8px;">We really appreciate your support!</p>
        </mj-text>
        <mj-image src="assets/staff-carrie-besnette-hauser-signature_black.png" alt="Signature" width="185px" padding="0" align="left" css-class="light-only" />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image src="assets/staff-carrie-besnette-hauser-signature_white.png" alt="Signature" width="185px" padding="0" align="left" css-class="dark-only" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
        <mj-text data-inset-toggle data-mobile-only-inset-right padding="8px 0 0">
          <p style="font-size:17px;margin:0;"><b>Carrie Besnette Hauser</b><br /><b>President &amp; Chief Executive Officer</b></p>
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- END: Signature Card (no photo) -->

    <!-- START: Category — Footers -->
    <mj-raw><div data-import-exclude="true" data-folder="6410" data-category-short="Footer"></mj-raw>
    <mj-section data-no-width-toggle css-class="text-block block" background-color="#000000" padding="8px 32px">
      <mj-column>
        <mj-text align="center" padding="0">
          <p style="font-size:14px;font-weight:700;letter-spacing:3px;color:#8CC63F;font-family:Menlo,Consolas,monospace;">FOOTERS</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-raw></div></mj-raw>
    <!-- END: Category — Footers -->

    <!-- START: Footer (w/ image) -->
    <mj-include path="./partials/tri-color-divider.mjml" />
    <mj-section css-class="footer-block block" background-color="#362229" padding="32px">
      <mj-column>
        <mj-image src="assets/text-and-arrow_2.png" href="https://www.example.com" alt="Supporters like you make our work possible" width="225px" align="center" padding="0 0 8px" css-class="light-only" />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image src="assets/text-and-arrow_2.png" href="https://www.example.com" alt="Supporters like you make our work possible" width="225px" align="center" padding="0 0 8px" css-class="dark-only" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
        <mj-button width="auto" color="#ffffff" background-color="#006837" href="https://www.example.com" align="center" padding="0 0 32px">DONATE</mj-button>
        <mj-text color="#ffffff" align="center" data-no-display-toggle padding="0 0 16px">
          <p style="font-size:14px;line-height:21px;"><b>Connecting everyone to the outdoors.</b> We create parks and protect public land where they're needed most so that everyone will have access to the benefits and joys of the outdoors for generations to come.</p>
        </mj-text>
        <mj-text color="#ffffff" align="center" data-no-display-toggle padding="0 0 16px">
          <p style="font-size:14px;line-height:21px;"><b>This email was sent by Trust for Public Land to<br />{user_data~Email Address}. Our mailing address is 23 Geary Street, Suite 1000, San Francisco, CA 94108.</b></p>
        </mj-text>
        <mj-image css-class="light-only" src="assets/logo-tpl_color-light-green-text.png" alt="Trust for Public Land" href="https://www.example.com" width="134px" align="center" padding="0 0 16px" data-no-display-toggle />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image css-class="dark-only" src="assets/logo-tpl_color-light-green-text.png" alt="Trust for Public Land" href="https://www.example.com" width="134px" align="center" padding="0 0 16px" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
        <mj-text css-class="wysiwyg link-inverse" color="#ffffff" align="center" data-no-display-toggle padding="0">
          <p style="font-size:14px;"><a href="https://www.example.com">Contact Us</a> | <a href="https://www.example.com">Privacy Policy</a> | <a href="https://www.example.com">Unsubscribe</a></p>
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- END: Footer (w/ image) -->

    <!-- START: Footer (w/ image, snow) -->
    <!-- data-visible-duplicate: the Snow-ground twin of Footer (w/ image) —
         same structure, light palette (user decision 2026-08-18). Deliberately
         visible alongside its anchor; never re-flag into the excluded family.
         The light arrow asset (text-and-arrow_3.png) is a programmatic Earth
         recolor of _2's white fill — swap the file if design supplies final
         artwork; the dark-mode twin keeps the white _2 art for the black
         repaint. -->
    <mj-include path="./partials/tri-color-divider.mjml" />
    <mj-section css-class="footer-block block" background-color="#F5FAF1" border="1px solid #FAFAFA" padding="32px" data-visible-duplicate>
      <mj-column>
        <mj-image src="assets/text-and-arrow_3.png" href="https://www.example.com" alt="Supporters like you make our work possible" width="225px" align="center" padding="0 0 8px" css-class="light-only" />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image src="assets/text-and-arrow_2.png" href="https://www.example.com" alt="Supporters like you make our work possible" width="225px" align="center" padding="0 0 8px" css-class="dark-only" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
        <mj-button width="auto" color="#ffffff" background-color="#006837" href="https://www.example.com" align="center" padding="0 0 32px">DONATE</mj-button>
        <mj-text align="center" data-no-display-toggle padding="0 0 16px">
          <p style="font-size:14px;line-height:21px;"><b>Connecting everyone to the outdoors.</b> We create parks and protect public land where they're needed most so that everyone will have access to the benefits and joys of the outdoors for generations to come.</p>
        </mj-text>
        <mj-text align="center" data-no-display-toggle padding="0 0 16px">
          <p style="font-size:14px;line-height:21px;"><b>This email was sent by Trust for Public Land to<br />{user_data~Email Address}. Our mailing address is 23 Geary Street, Suite 1000, San Francisco, CA 94108.</b></p>
        </mj-text>
        <mj-image css-class="light-only" src="assets/logo-tpl_all-black.png" alt="Trust for Public Land" href="https://www.example.com" width="134px" align="center" padding="0 0 16px" data-no-display-toggle />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image css-class="dark-only" src="assets/logo-tpl_color-light-green-text.png" alt="Trust for Public Land" href="https://www.example.com" width="134px" align="center" padding="0 0 16px" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
        <mj-text align="center" data-no-display-toggle padding="0">
          <p style="font-size:14px;"><a href="https://www.example.com">Contact Us</a> | <a href="https://www.example.com">Privacy Policy</a> | <a href="https://www.example.com">Unsubscribe</a></p>
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- END: Footer (w/ image, snow) -->

    <!-- END: Main Content -->
  </mj-body>
</mjml>

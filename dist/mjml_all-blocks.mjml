    <!-- START: Countdown Card -->
    <!-- Fallback colour is on THIS wrapper, never on the section carrying the image: MJML copies a section background-color onto the v:fill as color= and the Word engine paints that instead of the photo (measured 2026-08-13, EoA aBPD6k1l — variant A slabbed, B and C rendered). This is the same wrapper(colour) > section(image) shape the CTA Heroes use. It used to be a second, nested wrapper so the frame could stay #ffffff, but mj-wrapper inside mj-wrapper is invalid MJML; the frame is now the fallback colour instead (2026-08-19). -->
    <mj-wrapper css-class="block" background-color="#362229" padding="16px 48px">
        <mj-section css-class="image-block" background-url="assets/photo-river.jpg" background-size="cover" background-repeat="no-repeat" background-position="center center" border="1px solid #D9E3D9" padding="32px 0 32px">
        <mj-group>
          <mj-column width="25px">&nbsp;</mj-column>

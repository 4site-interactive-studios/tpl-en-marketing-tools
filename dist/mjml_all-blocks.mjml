         icon-heart_green.png, icon-thumbs-up.png, icon-prohibited.png -->
    <!-- START: Feedback Poll Option -->
    <mj-section css-class="poll-block block" background-color="#ffffff" padding="0 32px 8px">
      <mj-group>
        <!-- poll-icon/poll-text pin the group's column split on mobile
             (signature-img precedent): without them the 56px icon column
             compiles to 10.4478% and the fixed 32px gap padding squeezes
             the icon to under 1px at 375px (measured 2026-08-19, EoA). -->
        <mj-column width="56px" vertical-align="middle" css-class="poll-icon">
          <mj-image src="assets/icon-heart_green.png" alt="" width="24px" align="left" padding="0 32px 0 0" css-class="light-only" />
          <mj-raw><!--[if !mso]><!--></mj-raw>
          <mj-image src="assets/icon-heart_green.png" alt="" width="24px" align="left" padding="0 32px 0 0" css-class="dark-only" data-style-dark-mode />

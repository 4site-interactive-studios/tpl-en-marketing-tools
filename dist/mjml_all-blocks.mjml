    <!-- START: Feedback Poll Block -->
    <!-- No data-mobile-only-padding-right here, unlike the unified copy: this
         catalog's poll block is the question section ALONE, whose symmetric
         32px gutter takes the width-preset path — no per-side Select exists
         for the flag to scope, so it audits dead (measured 2026-08-18). The
         unified copy keeps the flag: its block bundles the option rows, whose
         56px icon column disables the preset and revives the per-side path. -->
    <mj-section css-class="poll-block block" background-color="#ffffff" padding="16px 32px 8px">
      <mj-column>
        <mj-text padding="0">
          <p style="font-size:17px;font-weight:700;">Lorem ipsum dolor sit amet consectetur adipiscing elit?</p>
        </mj-text>

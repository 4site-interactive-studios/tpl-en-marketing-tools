      <mj-column><mj-text color="#362229" padding="0"><p style="font-weight:700;margin:0;">C · Video Block — control (video-band restatement already shipped)</p></mj-text></mj-column>
    </mj-section>
<!-- probe copy: C Video Block -->
    <!-- Fallback colour lives on the wrapper, NOT this section: MJML copies a section background-color onto the v:fill as color=, and the Word engine then paints that instead of the photo (measured 2026-08-13, EoA aBPD6k1l — variant A slabbed, B and C rendered). Behind the section it still covers a blocked image. -->
    <mj-wrapper background-color="#4A7A68" padding="0">
      <!-- Band height = top + bottom padding + a fixed 128px overlay slot
           (BugHerd 293, user decision 2026-09-25: 16:9 / 3:2 / 1:1 at 600px
           wide, 16:9 the default; the old ~250px "short" band was dropped).
           The video-band class scale mints Padding Top and Padding Bottom
           Selects on those ratio steps (105 / 136 / 236 = 338 / 400 / 600px
           bands); set both to the same ratio.
           The overlay is one Display Select (user decision 2026-09-29):
           WATCH Button / Play Icon / Exclude Block. The icon is the button's
           data-alt-member, so it never renders in place — the importer folds
           it into the button's Select, and the build drops it from the
           previews. A 128px row in each rail holds the slot's height
           whichever option ships (the 128px icon, the ~50px button, or
           nothing), so the ratio steps stay true; vertical-align="middle"
           centres the button in it. The rows are mj-raw, not mj-spacer: a
           spacer is a column member and renumbered the trailing gap's tag
           (spacer_gap -> spacer_2_gap), and both rails carry one so the row
           stays symmetric and mints no Column Order. Rescaled from 144 / 175 / 275 when the
           slot replaced the button's ~50px. -->
      <mj-section css-class="image-block block video-band" background-url="assets/photo-kayak_color-overlay.jpg" background-size="cover" background-repeat="no-repeat" background-position="center center" padding="105px 0 105px">
        <mj-group>
          <mj-column width="25px" vertical-align="middle">
            <mj-raw><tr><td height="128" style="height:128px;line-height:128px;font-size:0;">&nbsp;</td></tr></mj-raw>
          </mj-column>
          <mj-column width="550px" vertical-align="middle">
            <mj-button data-display-toggle data-option-label="WATCH Button" width="auto" href="https://tpl.org" align="center" background-color="#4A7A68" color="#ffffff" border="2px solid #ffffff" padding="0">WATCH&nbsp;&nbsp;▷</mj-button>
            <mj-image data-alt-member="Play Icon" src="assets/icon-play-circle_orange.png" width="128px" alt="Play video" href="https://tpl.org" align="center" padding="0" />
          </mj-column>
          <mj-column width="25px" vertical-align="middle">
            <mj-raw><tr><td height="128" style="height:128px;line-height:128px;font-size:0;">&nbsp;</td></tr></mj-raw>
          </mj-column>
        </mj-group>
      </mj-section>
    </mj-wrapper>
    <mj-section css-class="block caption" background-color="#ffffff" padding="4px 0 0">
      <mj-column vertical-align="middle">
        <!-- data-display-toggle: the caption is the SOLE member of its column,
             and a sole member earns no Display Select otherwise. The gap above
             it is the SECTION's top padding, not the text's — the video sits in
             a different section, so the caption is its column's first element
             and the pacing rule sends the gap to the frame. 4px above / 8px
             below matches the image blocks (Image 1x1, Images 2x1/3x1), where
             the image carries no bottom padding of its own. 4 is on the caption
             class's own scale ("Quarter"), which is why this reads Quarter above
             and Half below rather than an off-scale pair. -->
        <mj-text data-display-toggle align="right" mj-class="caption" padding="0">
          <span>Video by Videographer&rsquo;s Name, AGENCY</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section css-class="spacer-block block" padding="0">
      <mj-column>
        <mj-spacer height="16px" />
      </mj-column>
    </mj-section>
    <!-- probe copy: C Video Block -->
  </mj-body>
</mjml>

<!-- probe copy: A5 Icon Row -->
    <!-- NOT an mj-group, deliberately. A group never stacks — it converts its
         children to percentages below the breakpoint and keeps them side by
         side (guide §6e), which is what held a 120px icon next to the text on
         a 375px screen. Plain columns stack, so on mobile the icon sits ABOVE
         the copy, left-aligned by the image's own align="left" (user decision
         2026-08-22). Desktop is unchanged: 120 + 448 = 568 fills the frame.
         The .icon-row-icon / .icon-row-text mobile pins went with the group —
         they existed to stop the group's percentage math squeezing the icon,
         and while stacked they would force both columns back to a side-by-side
         width. Steps Block keeps its pin; it is still grouped.
         Once stacked, the icon's 16px gutter (RIGHT padding on the images) is
         horizontal and buys no gap above the copy — styles.css gives
         .icon-row-icon a mobile-only padding-bottom:16px instead (user
         decision 2026-08-25, EoA FzaezTp…: the icon touched its text). -->
    <mj-section css-class="image-block block flush-mobile-capflush" background-color="#ffffff" padding="0 16px">
      <mj-column width="120px" vertical-align="middle" css-class="icon-row-icon">
          <mj-image src="assets/icon-box-and-heart.png" alt="" width="100px" align="left" padding="0 16px 0 0" css-class="light-only no-bleed" />
          <mj-raw><!--[if !mso]><!--></mj-raw>
          <mj-image src="assets/icon-box-and-heart.png" alt="" width="100px" align="left" padding="0 16px 0 0" css-class="dark-only no-bleed" data-style-dark-mode />
          <mj-raw><!--<![endif]--></mj-raw>
      </mj-column>
      <mj-column width="448px" vertical-align="middle" css-class="icon-row-text">
          <mj-text padding="0">
            <p><b>Lorem ipsum:</b> dolor sit amet consectetur. Morbi adipiscing convallis vitae. Cursus sed quam ornare augue quis metus. In viverra semper et lorem consequat pellentesque sfssjbl. <a href="https://tpl.org"><strong>Proin urna urna massa ut quis pulvinar senectus aenean. &gt;&gt;</strong></a></p>
          </mj-text>
      </mj-column>
    </mj-section>
    <!-- The section below is this row's ALTERNATE ARRANGEMENT: same content,
         no image, one full-width column. data-alt-arrangement folds it into
         the row's own Select as a third option instead of rendering it, so an
         editor picks Left / Right / No Icon from one control. It has to be
         AUTHORED rather than generated: the collapsed column needs
         mj-column-per-100 AND its head rules, and column widths are never
         generated. Keep its copy byte-identical to the primary's — the pairing
         matches on value, and drift does NOT fail loudly: measured 2026-08-22,
         one changed letter unpairs the alternate, which then renders as its
         OWN band (the content twice) and renumbers every band after it, with
         only an INFO note from the importer. The loud signal is check-catalog's
         alternate-arrangement guard, which compares the two copies here. -->
    <mj-section data-alt-arrangement="No Icon" css-class="image-block block flush-mobile-capflush" background-color="#ffffff" padding="0 16px">
      <mj-column>
      <mj-text padding="0">
          <p><b>Lorem ipsum:</b> dolor sit amet consectetur. Morbi adipiscing convallis vitae. Cursus sed quam ornare augue quis metus. In viverra semper et lorem consequat pellentesque sfssjbl. <a href="https://tpl.org"><strong>Proin urna urna massa ut quis pulvinar senectus aenean. &gt;&gt;</strong></a></p>
      </mj-text>
      </mj-column>
    </mj-section>
<mj-section css-class="spacer-block block" padding="0">

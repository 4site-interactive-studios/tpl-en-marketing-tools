    <mj-raw><div data-import-exclude="true" data-folder="6409" data-category-short="Utility"></mj-raw>
    <mj-section data-no-width-toggle css-class="text-block block" background-color="#000000" padding="8px 32px">
      <mj-column>
        <mj-text align="center" padding="0">
          <p style="font-size:14px;font-weight:700;letter-spacing:3px;color:#8CC63F;font-family:Menlo,Consolas,monospace;">UTILITIES</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-raw></div></mj-raw>
    <!-- END: Category — Utilities -->

    <!-- START: Spacer -->
    <mj-section css-class="spacer-block block" padding="0">
      <mj-column>
        <mj-spacer height="16px" container-background-color="#ffffff" />
      </mj-column>
    </mj-section>
    <!-- END: Spacer -->

    <!-- START: Divider (Single-color) -->
    <mj-section css-class="divider-block block" background-color="#ffffff" padding="16px 0" data-mobile-only-width>
      <mj-column>
        <mj-divider
          css-class="divider"
          border-width="3px"
          border-color="#006837"
          padding="0 16px"
          width="300px"
        />
      </mj-column>
    </mj-section>
    <!-- END: Divider (Single-color) -->

    <!-- START: Divider (Tri-color) -->
    <mj-include path="./partials/tri-color-divider.mjml" />
    <!-- END: Divider (Tri-color) -->

    <!-- START: Category — Signatures -->
    <mj-raw><div data-import-exclude="true" data-folder="6404" data-category-short="Signature"></mj-raw>
    <mj-section data-no-width-toggle css-class="text-block block" background-color="#000000" padding="8px 32px">
      <mj-column>
        <mj-text align="center" padding="0">
          <p style="font-size:14px;font-weight:700;letter-spacing:3px;color:#8CC63F;font-family:Menlo,Consolas,monospace;">SIGNATURES</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-raw></div></mj-raw>
    <!-- END: Category — Signatures -->

    <!-- START: Signature Card (square photo) -->
    <mj-section css-class="signature-block block" background-color="#ffffff" padding="16px 16px 0">
      <mj-column width="480px">
        <mj-text padding="0">
          <p style="font-style: italic;">
            With deep appreciation,
          </p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section css-class="signature-block block" background-color="#ffffff" padding="16px">
      <mj-group width="480px">
        <mj-column
          vertical-align="top"
          width="110px"
          css-class="signature-img" padding="0 8px 0 0">
          <mj-image
              src="assets/staff-carrie-besnette-hauser.png" width="100px"
              alt="Carrie Besnette Hauser"
              padding="0" css-class="light-only" />
          <mj-raw><!--[if !mso]><!--></mj-raw>
          <mj-image
              src="assets/staff-carrie-besnette-hauser.png" width="100px"
              alt="Carrie Besnette Hauser"
              padding="0" css-class="dark-only" data-style-dark-mode />
          <mj-raw><!--<![endif]--></mj-raw>
        </mj-column>
        <mj-column
          vertical-align="middle"
          width="365px"
          css-class="signature-text" padding="0 0 0 8px">
          <mj-image
              src="assets/staff-carrie-besnette-hauser-signature_black.png"
              alt="Signature"
              width="234px"
             padding="0 0 8px"
              align="left"
              css-class="light-only" />
          <mj-raw><!--[if !mso]><!--></mj-raw>
          <mj-image
              src="assets/staff-carrie-besnette-hauser-signature_white.png"
              alt="Signature"
              width="234px"
             padding="0 0 8px"
              align="left"
              css-class="dark-only" data-style-dark-mode />
          <mj-raw><!--<![endif]--></mj-raw>
          <mj-text font-size="16px" padding="0">
            <p style="font-family: Arial, sans-serif;">
              Carrie Besnette-Hauser
              <br />
              <em style="font-family: Georgia, serif;">Placeholder title, Example Division</em>
              <br />
              <b>Trust for Public Land</b>
            </p>
          </mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <!-- END: Signature Card (square photo) -->

    <!-- START: Category — Footers -->
    <mj-raw><div data-import-exclude="true" data-folder="6410" data-category-short="Footer"></mj-raw>
    <mj-section data-no-width-toggle css-class="text-block block" background-color="#000000" padding="8px 32px">
      <mj-column>
        <mj-text align="center" padding="0">
          <p style="font-size:14px;font-weight:700;letter-spacing:3px;color:#8CC63F;font-family:Menlo,Consolas,monospace;">FOOTERS</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-raw></div></mj-raw>
    <!-- END: Category — Footers -->

    <!-- START: Footer (w/ image) -->
    <mj-include path="./partials/tri-color-divider.mjml" />
    <mj-section css-class="footer-block block" background-color="#362229" padding="32px">
      <mj-column>
        <mj-image src="assets/text-and-arrow_2.png" href="https://www.example.com" alt="Supporters like you make our work possible" width="225px" align="center" padding="0 0 8px" css-class="light-only" />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image src="assets/text-and-arrow_2.png" href="https://www.example.com" alt="Supporters like you make our work possible" width="225px" align="center" padding="0 0 8px" css-class="dark-only" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
        <mj-button width="auto" color="#ffffff" background-color="#006837" href="https://www.example.com" align="center" padding="0 0 32px">DONATE</mj-button>
        <mj-text color="#ffffff" align="center" data-no-display-toggle padding="0 0 16px">
          <p style="font-size:14px;line-height:21px;"><b>Connecting everyone to the outdoors.</b> We create parks and protect public land where they're needed most so that everyone will have access to the benefits and joys of the outdoors for generations to come.</p>
        </mj-text>
        <mj-text color="#ffffff" align="center" data-no-display-toggle padding="0 0 16px">
          <p style="font-size:14px;line-height:21px;"><b>This email was sent by Trust for Public Land to<br />{user_data~Email Address}</b></p>
        </mj-text>
        <mj-image css-class="light-only" src="assets/logo-tpl_color-light-green-text.png" alt="Trust for Public Land" href="https://www.example.com" width="134px" align="center" padding="0 0 16px" data-no-display-toggle />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image css-class="dark-only" src="assets/logo-tpl_color-light-green-text.png" alt="Trust for Public Land" href="https://www.example.com" width="134px" align="center" padding="0 0 16px" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
        <mj-text color="#ffffff" align="center" data-no-display-toggle padding="0">
          <p style="font-size:14px;"><a href="https://www.example.com" style="color:#ffffff;">Contact Us</a> | <a href="https://www.example.com" style="color:#ffffff;">Privacy Policy</a> | <a href="https://www.example.com" style="color:#ffffff;">Unsubscribe</a></p>
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- END: Footer (w/ image) -->

    <!-- END: Main Content -->
  </mj-body>
</mjml>

    <!-- START: Photo and Text Grid (2x2) -->
    <mj-section
      css-class="text-block block"
      background-color="#362229" padding="16px 32px 0"
    >
      <mj-column>
        <mj-text padding="0">
          <h3 style="color:#ffffff;">Here's what's inspiring our TPL birders:</h3>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section
      css-class="image-block block"
      background-color="#362229" padding="8px 32px 0"
    >
      <mj-column width="50%" vertical-align="top" padding="0 8px 0 0">
        <mj-image
          src="assets/photo-person-and-bird-4.png"
          alt="Keith Maley and a ring-necked pheasant"
          width="248px"
          align="center"
         padding="0 0 16px" css-class="light-only" />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image
          src="assets/photo-person-and-bird-4.png"
          alt="Keith Maley and a ring-necked pheasant"
          width="248px"
          align="center"
         padding="0 0 16px" css-class="dark-only" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
        <mj-text color="#ffffff" padding="0 0 16px">
          <p style="font-size:16px;"><b>Keith Maley:</b> &ldquo;When I was four years old, I saw my spark bird. It was a ring-necked pheasant (shown above) under my neighbor Mary's bird feeder. I am obsessed with their colors, size, and tameness.&rdquo;</p>
        </mj-text>
      </mj-column>
      <mj-column width="50%" vertical-align="top" padding="0 0 0 8px">
        <mj-image
          src="assets/photo-person-and-bird-1.png"
          alt="Ronda Lee Chapman and a northern flicker"
          width="248px"
          align="center"
         padding="0 0 16px" css-class="light-only" />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image
          src="assets/photo-person-and-bird-1.png"
          alt="Ronda Lee Chapman and a northern flicker"
          width="248px"
          align="center"
         padding="0 0 16px" css-class="dark-only" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
        <mj-text color="#ffffff" padding="0 0 16px">
          <p style="font-size:16px;"><b>Ronda Lee Chapman:</b> &ldquo;My favorite bird is the northern flicker (shown above). They are abundant in Denver and visit me often throughout my days. I love their call and how beautiful they are.&rdquo;</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section
      css-class="image-block block"
      background-color="#362229" padding="8px 32px 0"
    >
      <mj-column width="50%" vertical-align="top" padding="0 8px 0 0">
        <mj-image
          src="assets/photo-person-and-bird-2.png"
          alt="Taj Schottland and a northern cardinal"
          width="248px"
          align="center"
         padding="0 0 16px" css-class="light-only" />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image
          src="assets/photo-person-and-bird-2.png"
          alt="Taj Schottland and a northern cardinal"
          width="248px"
          align="center"
         padding="0 0 16px" css-class="dark-only" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
        <mj-text color="#ffffff" padding="0 0 16px" data-mobile-only-spacing-below>
          <p style="font-size:16px;"><b>Taj Schottland:</b> &ldquo;When I was four years old, I saw my spark bird. It was a ring-necked pheasant (shown above) under my neighbor Mary's bird feeder. I am obsessed with their colors, size, and tameness.&rdquo;</p>
        </mj-text>
      </mj-column>
      <mj-column width="50%" vertical-align="top" padding="0 0 0 8px">
        <mj-image
          src="assets/photo-person-and-bird-3.png"
          alt="Jeff Danter and a great egret"
          width="248px"
          align="center"
         padding="0 0 16px" css-class="light-only" />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image
          src="assets/photo-person-and-bird-3.png"
          alt="Jeff Danter and a great egret"
          width="248px"
          align="center"
         padding="0 0 16px" css-class="dark-only" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
        <mj-text color="#ffffff" padding="0 0 16px">
          <p style="font-size:16px;"><b>Jeff Danter:</b> &ldquo;My favorite TPL-protected birding spot is the Chattahoochee RiverLands. This green oasis that runs through the heart of suburban Atlanta is a natural migration corridor that fills with the songs of hundreds of species every spring.&rdquo;</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section
      css-class="text-block block"
      background-color="#362229" padding="0 32px 16px"
    >
      <mj-column>
        <mj-text align="right" mj-class="caption" color="#ffffff" padding="0">
          <span>Photos <a href="https://www.example.com" style="color:#ffffff;">Flickr</a>: Oregon Department of Fish &amp; Wildlife, USFWS Mountain-Prairie, Mary Shattock, Shawn Taylor</span>
        </mj-text>
      </mj-column>
    </mj-section>

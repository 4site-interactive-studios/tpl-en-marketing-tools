    <!-- START: Join Links Block -->
    <mj-section
      css-class="text-block block"
      background-color="#CEE4C5" padding="16px 32px" data-fully-exclude
    >
      <mj-column>
        <mj-text padding="0">
          <h2><a href="https://www.example.com" style="color:#006837;">Join Our Advisory Board</a></h2>
          <p style="font-size:16px;">
            Advisory board members are TPL advocates, ambassadors, and donors
            who help increase our impact through philanthropy, advocacy,
            connections, and strategic guidance.
          </p>
          <h2><a href="https://www.example.com" style="color:#006837;">Join Our Team</a></h2>
          <p style="font-size:16px;">
            Come join a passionate team working toward a mission you believe
            in. <a href="https://www.example.com" style="color:#006837;font-weight:bold;">View all open positions.</a>
          </p>
          <p style="font-size:14px;">
            Was this email forwarded to you? <a href="https://www.example.com" style="color:#006837;font-weight:bold;">Sign up here.</a>
          </p>
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- END: Join Links Block -->

    <!-- START: Quiz Block (multiple choice) -->
    <mj-section
      css-class="text-block block"
      background-color="#362229" padding="16px 32px"
    >

    <!-- END: Body Text (inset) -->

    <!-- START: Heading (linked), Text, and CTA -->
    <mj-section css-class="text-block block inset-gutter" background-color="#ffffff" padding="16px 64px">
      <mj-column>
        <mj-text padding="0 0 16px">
          <h2><a href="https://www.example.com">Ray Has Big Ideas for Texas</a></h2>
          <p style="font-size:16px;">
            Lorem ipsum dolor sit amet consectetur. Morbi adipiscing convallis
            vitae quisque commodo volutpat ut. Cursus sed quam ornare augue
            quis metus. Fermentum sit id pharetra tortor. In viverra semper et
            lorem consequat pellentesque. Proin urna urna massa ut quis augue
            pulvinar senectus aenean. Non sit volutpat quam pretium risus
            ullamcorper
          </p>
        </mj-text>
        <mj-text css-class="button" padding="0">
          <!--[if mso]><table role="presentation" align="left" cellpadding="0" cellspacing="0" border="0"><tr><td bgcolor="#006837" style="border-radius:100px;mso-padding-alt:12px 16px;" valign="middle"><![endif]-->
          <div class="cta-group" style="text-align:left;font-size:0;"><!--[if !mso]><!--><div class="cta-item" style="display:inline-block;vertical-align:middle;margin-right:16px;"><!--<![endif]--><!--[if mso]><div class="cta-item" style="display:inline-block;vertical-align:middle;"><![endif]--><a href="https://www.example.com" style="display:inline-block;background-color:#006837;color:#ffffff;border-radius:100px;padding:12px 16px;font-family:Tahoma,sans-serif;font-size:18px;font-weight:700;letter-spacing:1px;line-height:25px;text-decoration:none;mso-padding-alt:0;white-space:nowrap;">LEARN MORE</a></div><!--[if mso]></td><td width="16" style="width:16px;font-size:0;line-height:0;">&nbsp;</td><td bgcolor="#006837" style="border-radius:100px;mso-padding-alt:12px 16px;" valign="middle"><![endif]--><div class="cta-item" style="display:inline-block;vertical-align:middle;"><a href="https://www.example.com" style="display:inline-block;background-color:#006837;color:#ffffff;border-radius:100px;padding:12px 16px;font-family:Tahoma,sans-serif;font-size:18px;font-weight:700;letter-spacing:1px;line-height:25px;text-decoration:none;mso-padding-alt:0;white-space:nowrap;">WATCH</a></div></div>
          <!--[if mso]></td></tr></table><![endif]-->
        </mj-text>
      </mj-column>
    </mj-section>

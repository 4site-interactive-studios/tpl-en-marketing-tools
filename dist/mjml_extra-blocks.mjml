    <!-- START: Steps Block (w/ arrow heading) -->
    <mj-include path="./partials/green-rule-divider.mjml" />
    <mj-section css-class="text-block block" background-color="#F5FAF1" padding="16px 32px">
      <mj-group>
        <mj-column width="90px" vertical-align="top">
          <mj-image src="assets/icon-arrow-orange.png" alt="" width="70px" align="left" padding="0 16px 0 0" css-class="light-only" />
          <mj-raw><!--[if !mso]><!--></mj-raw>
          <mj-image src="assets/icon-arrow-orange.png" alt="" width="70px" align="left" padding="0 16px 0 0" css-class="dark-only" data-style-dark-mode />
          <mj-raw><!--<![endif]--></mj-raw>
        </mj-column>
        <mj-column width="446px" vertical-align="middle">
          <mj-text padding="0">
            <h3 style="color:#39B54A;font-style:italic;">It's easy to send your comment&mdash;<br />just follow these simple steps:</h3>
          </mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section css-class="text-block block" background-color="#F5FAF1" padding="0 32px 16px">
      <mj-column>
        <mj-text padding="0 0 16px">
          <p style="font-size:16px;margin-bottom:2px;"><span class="step-num">&nbsp;1&nbsp;</span>&nbsp; <b>Share your name.</b></p>
          <p style="font-size:16px;margin-top:0;">Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
          <p style="font-size:16px;margin-bottom:2px;"><span class="step-num">&nbsp;2&nbsp;</span>&nbsp; <b>Thank [Agency Name].</b></p>
          <p style="font-size:16px;margin-top:0;">Let them know you appreciate the chance to weigh in.</p>
          <p style="font-size:16px;margin-bottom:2px;"><span class="step-num">&nbsp;3&nbsp;</span>&nbsp; <b>Say why this matters to you.</b></p>
          <p style="font-size:16px;margin-top:0;">Explain why it's essential that park interpretation reflects all of America's history&mdash;and why strong staffing and funding are needed to make that possible.</p>
          <p style="font-size:16px;margin-bottom:2px;"><span class="step-num">&nbsp;4&nbsp;</span>&nbsp; <b>Add your personal touch.</b></p>
          <p style="font-size:16px;margin-top:0;">Share a meaningful park memory or experience&mdash;something that helped you learn or feel connected.</p>
          <p style="font-size:16px;margin-bottom:2px;"><span class="step-num">&nbsp;5&nbsp;</span>&nbsp; <b>Close with your request.</b></p>
          <p style="font-size:16px;margin-top:0;">Call on the NPS to research, preserve, and share all aspects of our history&mdash;and to fund this work so these stories can be told.</p>
        </mj-text>
        <mj-button width="auto" href="https://www.example.com" align="left" padding="0 0 16px" color="#ffffff" background-color="#006837">LEARN MORE</mj-button>
        <mj-text css-class="wysiwyg link-accent" padding="0">
          <p style="font-size:13px;line-height:19px;font-style:italic;">This button will take you to <a href="https://www.example.com">[the public comment portal]</a>, the official site where you can send your comment straight to [Agency Name].</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-include path="./partials/green-rule-divider.mjml" />
    <!-- END: Steps Block (w/ arrow heading) -->


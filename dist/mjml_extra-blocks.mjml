<mjml lang="en">
  <mj-head>
    <!-- en-tools-config {
      "spacingScale": { "None": 0, "Half": 8, "Single": 16, "Double": 32, "Triple": 48, "Quadruple": 64 },
      "classSpacingScales": {
        "caption": { "None": 0, "Quarter": 4, "Half": 8, "Single": 16, "Double": 32, "Triple": 48, "Quadruple": 64 },
        "hero-reveal": { "None": 0, "Half": 8, "Single": 16, "Double": 32, "Triple": 48, "Quadruple": 64, "100": 100, "150": 150, "200": 200, "250": 250, "300": 300, "350": 350, "400": 400, "450": 450, "500": 500 }
      },
      "widthPresets": { "Full Bleed": 0, "Single": 16, "Double": 32, "Triple": 48, "Quadruple": 64 },
      "geometryReachPx": 64,
      "brandColors": { "Snow": "#F5FAF1", "Moss": "#CEE4C5", "Earth": "#362229", "Evergreen": "#006837", "Fern": "#39B54A", "Grass": "#8CC63F", "Sky": "#5DD8D8", "Sun": "#F7931E", "Light Grey": "#FAFAFA" }
    } -->
    <mj-breakpoint width="600px" />
    <mj-title>TPL Email Template — Demo Catalog</mj-title>
    <!-- No mj-preview: EN injects its own hidden preheader from each email's Preview Text setting (measured 2026-08-10) — a template-baked one would double up in inbox snippets. Autoresponder sources (donation-thank-you) keep theirs; they do not go out through Marketing Tools broadcasts. -->

    <!-- Baseline everything inherits -->
    <mj-attributes>
      <mj-text
        color="#000000"
        font-size="18px"
        font-weight="400"
        font-family="Tahoma, sans-serif"
        line-height="24px"
        css-class="wysiwyg"
      />
      <mj-button width="auto"
        css-class="button"
        font-size="18px"
        font-weight="700"
        font-family="Tahoma, sans-serif"
        line-height="25px"
        border-radius="100px"
        inner-padding="12px 16px"
        letter-spacing="1px"
        color="#ffffff"
        background-color="#006837"
      />
      <mj-image
        padding="0" />

      <!-- Reusable variants — apply with mj-class="*" -->
      <mj-class
        name="caption"
        font-size="10px"
        line-height="16px"
        padding="4px 0 0 0"
      />
    </mj-attributes>

    <!-- No mj-style @media blocks here: EN merges same-condition @media
         blocks into the FIRST occurrence's position (measured 2026-08-19,
         EoA delivered heads), so a 599px block in this head would drag
         styles.css's 599px rules ahead of the order-dependent hides that
         precede them there. All mobile rules live in styles.css. -->

    <mj-raw>
      <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" />
      <meta name="format-detection" content="telephone=no" />
    </mj-raw>
    <!-- Marketing Tools builder bands. The data-en-tools-band attribute keeps
         this sheet in the template HEAD: the importer splices every other
         style element out into the Template Styles block, and this layout has
         to survive an email built without that block. __TEMPLATE_VERSION__ is
         filled in at import from versions.json; keeping the literal here is
         what stops the version from feeding its own hash.

         TWO SEPARATE RULES, DELIBERATELY NOT MERGED INTO ONE SELECTOR LIST.

         BLOCK bands hang off a span the app injects into the block's own
         content, gated on whether a block wrapper exists anywhere in the
         document — true while editing in EN, false in a delivered email.

         The TEMPLATE band hangs off EN's container element instead. A span
         authored in the template shell does NOT work (measured 2026-08-20):
         EN's builder renders blocks inside the container and does not render
         the template's own surrounding markup, so such a span never enters
         the builder DOM at all. [data-container="main"] IS that container,
         and it is self-gating — the stored template carries EN's container
         placeholder there and a delivered email carries the blocks
         themselves, so nothing bears the attribute outside the editor.

         Do NOT write EN's container merge tag literally anywhere in this
         file. autoEnableTemplateReplacements splits the shell on the FIRST
         occurrence of that tag, so a literal in a comment splits the head at
         the comment instead of at the real container: the comment loses its
         terminator, swallows the whole stylesheet, and every light/dark image
         pair renders both halves. Measured 2026-08-20; check-catalog guards it.

         Merging the two selectors would be a live hazard: one unsupported
         selector in a group invalidates the WHOLE rule, so a client that
         cannot parse :has() would take the template band down with it. -->
    <mj-raw>
      <style type="text/css" data-en-tools-band>
        /* max-width tracks the EMAIL width — keep it equal to
           div[data-container]{max-width} in styles.css, or the block band
           stops centring over the column it labels. check-catalog's
           "Builder band width tracks the email width" guard enforces it. */
        :is(body):has(.en__emailbuilder__block) .marketing-tools-banner{
          display: flex !important;
          font-weight: 700 !important;
          font-family: sans-serif !important;
          color: #4e535c !important;
          line-height: 2rem !important;
          position: absolute !important;
          top: 1.75rem !important;
          width: 100% !important;
          max-width: 600px !important;
          justify-content: center !important;
          background-color: #d0d5dd !important;
        }
        [data-container="main"]:before{
          content: "Email Template v__TEMPLATE_VERSION__";
          display: block !important;
          font-weight: 700 !important;
          font-family: sans-serif !important;
          color: #4e535c !important;
          line-height: 1.75rem !important;
          text-align: center !important;
          margin-bottom: 2rem !important;
          background-color: #d0d5dd !important;
        }
      </style>
    </mj-raw>

    <mj-include path="./styles.css" type="css" />
  </mj-head>
  <mj-body css-class="email-body" background-color="#ffffff">

    <mj-include path="./partials/debug-toolbar.mjml" />

    <!-- START: Main Content -->

    <!-- START: Category — Headers and Heroes -->
    <mj-raw><div data-import-exclude="true" data-folder="6399" data-category-short="Headers/Heroes"></mj-raw>
    <mj-section data-no-width-toggle css-class="text-block block" background-color="#000000" padding="8px 32px">
      <mj-column>
        <mj-text align="center" padding="0">
          <p style="font-size:14px;font-weight:700;letter-spacing:3px;color:#8CC63F;font-family:Menlo,Consolas,monospace;">HEADERS AND HEROES</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-raw></div></mj-raw>
    <!-- END: Category — Headers and Heroes -->

    <!-- START: Logo Hero (no CTA) -->
    <mj-section css-class="image-block block" background-color="#CEE4C5" padding="16px 32px">
      <mj-column vertical-align="middle">
        <mj-image css-class="light-only" src="assets/logo-tpl_color-black-text.png" alt="Trust for Public Land" href="https://www.example.com" width="154px" align="left" />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image css-class="dark-only" src="assets/logo-tpl_color-light-green-text.png" alt="Trust for Public Land" href="https://www.example.com" width="154px" align="left" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
      </mj-column>
    </mj-section>
    <!-- END: Logo Hero (no CTA) -->

    <!-- START: Logo Hero (w/ text and image) -->
    <mj-section css-class="image-block block" background-color="#700310" padding="16px 32px">
      <mj-group>
        <mj-column vertical-align="middle" width="50%">
          <mj-image css-class="light-only" src="assets/logo-tpl_all-light-green.png" alt="Trust for Public Land" href="https://www.example.com" width="154px" padding="0 16px 0 0" align="left" />
          <mj-raw><!--[if !mso]><!--></mj-raw>
          <mj-image css-class="dark-only" src="assets/logo-tpl_all-light-green.png" alt="Trust for Public Land" href="https://www.example.com" width="154px" padding="0 16px 0 0" align="left" data-style-dark-mode />
          <mj-raw><!--<![endif]--></mj-raw>
        </mj-column>
        <mj-column vertical-align="middle" width="50%">
          <mj-text align="right" color="#ffffff" padding="0 0 8px">
            <p style="font-size:12px;line-height:14px;margin:0;">North Carolina</p>
          </mj-text>
          <mj-image css-class="light-only" src="assets/state-north-carolina.png" alt="North Carolina" href="https://www.example.com" width="104px" padding="0 0 0 16px" align="right" data-mobile-only-inset-left />
          <mj-raw><!--[if !mso]><!--></mj-raw>
          <mj-image css-class="dark-only" src="assets/state-north-carolina.png" alt="North Carolina" href="https://www.example.com" width="104px" padding="0 0 0 16px" align="right" data-style-dark-mode />
          <mj-raw><!--<![endif]--></mj-raw>
        </mj-column>
      </mj-group>
    </mj-section>
    <!-- END: Logo Hero (w/ text and image) -->

    <!-- START: CTA Hero (w/ badge image) -->
    <mj-section css-class="image-block block" background-color="#ffffff" border="1px solid #D9E3D9" padding="16px 32px">
      <mj-group>
        <mj-column vertical-align="middle" width="50%">
          <mj-image css-class="light-only" src="assets/logo-tpl_color-black-text.png" alt="Trust for Public Land" href="https://www.example.com" width="154px" padding="0 16px 0 0" align="left" />
          <mj-raw><!--[if !mso]><!--></mj-raw>
          <mj-image css-class="dark-only" src="assets/logo-tpl_color-light-green-text.png" alt="Trust for Public Land" href="https://www.example.com" width="154px" padding="0 16px 0 0" align="left" data-style-dark-mode />
          <mj-raw><!--<![endif]--></mj-raw>
        </mj-column>
        <mj-column vertical-align="middle" width="50%">
          <mj-image css-class="light-only" src="assets/cta-giving-tuesday_color.png" alt="Placeholder graphic" href="https://www.example.com" width="163px" padding="0 0 8px" align="right" />
          <mj-raw><!--[if !mso]><!--></mj-raw>
          <mj-image css-class="dark-only" src="assets/cta-giving-tuesday_white.png" alt="Placeholder graphic" href="https://www.example.com" width="163px" padding="0 0 8px" align="right" data-style-dark-mode />
          <mj-raw><!--<![endif]--></mj-raw>
          <mj-button width="auto" href="https://www.example.com" align="right" padding="0" color="#ffffff" background-color="#006837">READ MORE</mj-button>
        </mj-column>
      </mj-group>
    </mj-section>
    <!-- END: CTA Hero (w/ badge image) -->

    <!-- START: CTA Hero (fixed height, logo and background image) -->
    <!-- Fallback colour lives on the wrapper, NOT this section: MJML copies a section background-color onto the v:fill as color=, and the Word engine then paints that instead of the photo (measured 2026-08-13, EoA aBPD6k1l — variant A slabbed, B and C rendered). Behind the section it still covers a blocked image. -->
    <mj-wrapper background-color="#362229" padding="0">
      <mj-section css-class="image-block block" background-url="assets/photo-trail.jpg" background-size="cover" background-repeat="no-repeat" background-position="center center" padding="160px 32px 32px">
        <mj-group>
          <mj-column vertical-align="middle" width="40%">
            <mj-image css-class="light-only" src="assets/logo-tpl_color-light-green-text.png" alt="Trust for Public Land" href="https://www.example.com" width="154px" padding="0 16px 0 0" align="left" />
            <mj-raw><!--[if !mso]><!--></mj-raw>
            <mj-image css-class="dark-only" src="assets/logo-tpl_color-light-green-text.png" alt="Trust for Public Land" href="https://www.example.com" width="154px" padding="0 16px 0 0" align="left" data-style-dark-mode />
            <mj-raw><!--<![endif]--></mj-raw>
          </mj-column>
          <mj-column vertical-align="middle" width="60%">
            <mj-button css-class="button fixed-width" width="auto" href="https://www.example.com" align="right" background-color="#F7931E" font-size="16px" padding="0" color="#ffffff">LEARN MORE</mj-button>
          </mj-column>
        </mj-group>
      </mj-section>
    </mj-wrapper>
    <!-- END: CTA Hero (fixed height, logo and background image) -->

    <!-- START: CTA Hero (centered w/ background image) -->
    <!-- Fallback colour lives on the wrapper, NOT this section: MJML copies a section background-color onto the v:fill as color=, and the Word engine then paints that instead of the photo (measured 2026-08-13, EoA aBPD6k1l — variant A slabbed, B and C rendered). Behind the section it still covers a blocked image. -->
    <mj-wrapper background-color="#006837" padding="0">
      <mj-section css-class="image-block block" background-url="assets/photo-forest.jpg" background-size="cover" background-repeat="no-repeat" background-position="center center" padding="48px 32px 48px">
        <mj-group>
        <mj-column>
          <mj-text align="center" padding="0 0 16px">
            <h1 style="color:#ffffff;">Lorem Ipsum Dolor Sit Amet</h1>
          </mj-text>
          <mj-button css-class="button fixed-width" width="auto" href="https://www.example.com" align="center" background-color="#F7931E" padding="0" color="#ffffff">LEARN MORE</mj-button>
        </mj-column>
        </mj-group>
      </mj-section>
    </mj-wrapper>
    <!-- END: CTA Hero (centered w/ background image) -->

    <!-- START: Category — Text Blocks -->
    <mj-raw><div data-import-exclude="true" data-folder="6400" data-category-short="Text"></mj-raw>
    <mj-section data-no-width-toggle css-class="text-block block" background-color="#000000" padding="8px 32px">
      <mj-column>
        <mj-text align="center" padding="0">
          <p style="font-size:14px;font-weight:700;letter-spacing:3px;color:#8CC63F;font-family:Menlo,Consolas,monospace;">TEXT BLOCKS</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-raw></div></mj-raw>
    <!-- END: Category — Text Blocks -->

    <!-- START: Heading -->
    <mj-section css-class="text-block block" background-color="#ffffff" padding="16px 32px">
      <mj-column><mj-text align="center" padding="0"><h1 style="color:#362229;">Lorem Ipsum</h1></mj-text></mj-column>
    </mj-section>
    <!-- END: Heading -->

    <!-- START: Heading, Text, and CTA -->
    <mj-section css-class="text-block block inset-gutter" background-color="#ffffff" padding="16px 64px">
      <mj-column>
        <mj-text padding="0 0 16px">
          <h1 style="font-weight:400;color:#362229;">Lorem Ipsum <b>Dolor Sit Amet Consectetur. Pulvinar Feugi</b></h1>

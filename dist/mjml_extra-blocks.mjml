    <!-- START: Photo Grid (2x2) -->
    <mj-section css-class="image-block block flush-mobile-capflush" background-color="#ffffff" padding="16px 32px 0">
      <mj-column width="50%" vertical-align="top" padding="0 8px 0 0">
        <mj-image src="assets/icon-rollover-qcd-giving.png" alt="Placeholder icon" href="https://www.example.com" width="220px" align="center" padding="0 0 16px" css-class="inline-fluid light-only" />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image src="assets/icon-rollover-qcd-giving.png" alt="Placeholder icon" href="https://www.example.com" width="220px" align="center" padding="0 0 16px" css-class="inline-fluid dark-only" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
      </mj-column>
      <mj-column width="50%" vertical-align="top" padding="0 0 0 8px">
        <mj-image src="assets/icon-donor-advised-fund.png" alt="Placeholder icon" href="https://www.example.com" width="220px" align="center" padding="0 0 16px" css-class="inline-fluid light-only" />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image src="assets/icon-donor-advised-fund.png" alt="Placeholder icon" href="https://www.example.com" width="220px" align="center" padding="0 0 16px" css-class="inline-fluid dark-only" data-style-dark-mode />
        <mj-raw><!--<![endif]--></mj-raw>
      </mj-column>
    </mj-section>
    <mj-section css-class="image-block block flush-mobile-capflush" background-color="#ffffff" padding="0 32px 16px">
      <mj-column width="50%" vertical-align="top" padding="0 8px 0 0">
        <mj-image src="assets/icon-planned-giving.png" alt="Placeholder icon" href="https://www.example.com" width="220px" align="center" padding="0" css-class="inline-fluid light-only" />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image src="assets/icon-planned-giving.png" alt="Placeholder icon" href="https://www.example.com" width="220px" align="center" padding="0" css-class="inline-fluid dark-only" data-style-dark-mode />

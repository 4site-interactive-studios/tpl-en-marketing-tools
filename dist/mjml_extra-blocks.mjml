    <!-- START: Two-Line Banner (light green) -->
    <!-- data-mobile-only-width: the two centered caps lines clear every preset at 600px, so the gutter is invisible at desktop; at 375px the wider steps force a wrap. Measured INERT desktop / live mobile 2026-08-18. Drop the flag if the banner copy ever wraps at desktop. -->
    <mj-section css-class="text-block block two-line-banner-block" background-color="#CEE4C5" padding="16px 32px" data-mobile-only-width>
      <mj-column>
        <mj-text align="center" padding="0">
          <p style="font-size:22px;line-height:26px;font-weight:700;color:#362229;margin:0;">LOREM IPSUM DOLOR SIT</p>
          <p style="font-size:34px;line-height:38px;font-weight:700;color:#700310;margin:0;">NOW ACTIVE</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- END: Two-Line Banner (light green) -->

    <!-- START: Stat Row (green) -->
    <mj-wrapper css-class="block" background-color="#ffffff" padding="0 32px 16px">
      <mj-section background-color="#CEE4C5" border="1px solid #39B54A" padding="32px">
        <mj-column>
          <mj-text css-class="wysiwyg link-earth" align="center" padding="0 0 8px">
            <h3 style="color:#362229;">YOUR 2025 CONSERVATION<br />CHAMPION SUPPORT SNAPSHOT</h3>
            <p style="font-size:16px;"><b>Supporter ID:</b></p>
            <p style="font-size:15px;"><b>Year-to-Date Donation Total: Contact us for more information</b></p>
            <p style="font-size:18px;margin-bottom:2px;"><b>LOREM IPSUM DOLOR SIT</b></p>
            <p style="font-size:15px;margin-top:0;"><b>Opportunity Status:</b> <a href="https://www.example.com">Still able to make an impact!</a></p>
            <p style="font-size:15px;margin-bottom:2px;"><b>Suggested Donation:</b> $1,000 (makes $5,000 of impact!)</p>
            <p style="font-size:15px;margin-top:0;color:#F7931E;"><b>Deadline: Midnight, December 31, 2025</b></p>
          </mj-text>
          <mj-button width="auto" href="https://www.example.com" align="center" padding="0" color="#ffffff" background-color="#006837">LEARN MORE</mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <!-- END: Stat Row (green) -->

    <!-- START: Category — Images & Media -->
    <mj-raw><div data-import-exclude="true" data-folder="6401" data-category-short="Images"></mj-raw>
    <mj-section data-no-width-toggle css-class="text-block block" background-color="#000000" padding="8px 32px">

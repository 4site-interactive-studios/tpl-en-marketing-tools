        <mj-text align="center" padding="0">
          <p style="font-size:14px;font-weight:700;letter-spacing:3px;color:#8DC63F;font-family:Menlo,Consolas,monospace;">COL D — CONTROL + INLINED MIN-WIDTH</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- END: Probe Label D -->

    <!-- START: Probe D MinWidth -->
    <mj-section css-class="two-col-image-text-block block" background-color="#ffffff" padding="16px 32px">
      <mj-column css-class="two-col-column first-column probe-minw-240" width="240px" vertical-align="top" padding="0 8px">
        <mj-image src="assets/photo-garden.jpg" width="224px" alt="Children exploring plants in a schoolyard garden" href="https://www.example.com" padding="0 0 8px" align="center" fluid-on-mobile="true" css-class="two-col-image light-only" />
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-image src="assets/photo-garden.jpg" width="224px" alt="Children exploring plants in a schoolyard garden" href="https://www.example.com" padding="0 0 8px" align="center" fluid-on-mobile="true" css-class="two-col-image dark-only" />

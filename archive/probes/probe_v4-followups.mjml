      <mj-column css-class="two-col-column" width="53%" vertical-align="top" padding="0 8px">
        <mj-text padding="0 0 16px">
          <h3 style="color:#362229;">B percent card heading.</h3>
          <p style="font-size:16px;">
            Lorem ipsum dolor sit amet consectetur. Morbi adipiscing convallis

    <!-- END: Probe B Percent -->

    <!-- START: Probe Label C -->
    <mj-section data-fully-exclude css-class="text-block block" background-color="#000000" padding="8px 32px">
      <mj-column>
        <mj-text align="center" padding="0">
          <p style="font-size:14px;font-weight:700;letter-spacing:3px;color:#8DC63F;font-family:Menlo,Consolas,monospace;">COL C — MJ-GROUP (NO STACKING)</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- END: Probe Label C -->

    <!-- START: Probe C Group -->
    <mj-section css-class="two-col-image-text-block block" background-color="#ffffff" padding="16px 32px">
      <mj-group>
        <mj-column css-class="two-col-column first-column" width="240px" vertical-align="top" padding="0 8px">
          <mj-image src="assets/photo-garden.jpg" width="224px" alt="Children exploring plants in a schoolyard garden" href="https://www.example.com" padding="0 0 8px" align="center" css-class="two-col-image light-only" />
          <mj-raw><!--[if !mso]><!--></mj-raw>
          <mj-image src="assets/photo-garden.jpg" width="224px" alt="Children exploring plants in a schoolyard garden" href="https://www.example.com" padding="0 0 8px" align="center" css-class="two-col-image dark-only" />
          <mj-raw><!--<![endif]--></mj-raw>
          <mj-text align="right" mj-class="caption" padding="0">
            <span>Photograph by Photographer</span>
          </mj-text>
        </mj-column>
        <mj-column css-class="two-col-column" width="296px" vertical-align="top" padding="0 8px">
          <mj-text padding="0 0 16px">
            <h3 style="color:#362229;">C group card heading.</h3>
            <p style="font-size:16px;">
              Lorem ipsum dolor sit amet consectetur. Morbi adipiscing convallis

        <mj-text align="center" padding="0">
          <p style="font-size:14px;font-weight:700;letter-spacing:3px;color:#8DC63F;font-family:Menlo,Consolas,monospace;">COL B — PERCENT COLUMNS (45/53)</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- END: Probe Label B -->

    <!-- START: Probe B Percent -->
